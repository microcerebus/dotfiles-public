{
  "cleanupPeriodDays": 365,
  "bashOutputMaxChars": 15000,
  "autoCompactEnabled": true,
  "autoCompactWindow": 300000,
  "remoteControlAtStartup": false,
  "claudeMdExcludes": ["/Users/*/AGENTS.md"],
  "deniedMcpServers": [{ "serverName": "claude.ai Claude Docs" }, { "serverName": "claude.ai Telegram" }],
  "skillOverrides": {
    "anthropic-skills:built-in-browser": "user-invocable-only",
    "anthropic-skills:chrome-browser": "user-invocable-only",
    "anthropic-skills:computer-use": "user-invocable-only",
    "anthropic-skills:docs": "user-invocable-only",
    "anthropic-skills:docx": "name-only",
    "anthropic-skills:pdf": "name-only",
    "anthropic-skills:pptx": "name-only",
    "anthropic-skills:xlsx": "name-only"
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "~/dotfiles/scripts/dotfiles-autoupdate status --alarms", "timeout": 5 }] },
      { "hooks": [{ "type": "command", "command": "~/dotfiles/scripts/axi-session-start", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "python3 -I ~/.claude/hooks/turn_context.py", "timeout": 5 }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "python3 -I ~/.claude/hooks/bash_guard.py", "timeout": 5 }] }
    ],
    "PreCompact": [
      { "matcher": "auto", "hooks": [{ "type": "command", "command": "python3 -I ~/.claude/hooks/pre_compact.py", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit", "hooks": [{ "type": "command", "command": "python3 -I ~/.claude/hooks/write_guard.py", "timeout": 5 }] },
      { "matcher": "*", "hooks": [{ "type": "command", "command": "python3 -I ~/.claude/hooks/turn_context.py", "timeout": 5 }] }
    ]
  }
}
