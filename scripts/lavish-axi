#!/bin/sh
# Lavish was retired on 20 Oct 2026. scripts/ comes before pnpm's bin on PATH,
# so a bare lavish-axi from an old note or skill stops here instead of running
# the upstream CLI, which opens the default browser.
# Test: tests/lavish_retired_test.sh.
cat >&2 <<'MSG'
lavish-axi: Lavish is retired (20 Oct 2026); nothing was run.
Show a visual reply with T3's html_render, or a long-lived page as a pack in ~/packs: see the visual-reply skill.
MSG
exit 2
