#!/usr/bin/env node
// The one way an agent uses the agent Chrome (Google Chrome Beta on 127.0.0.1:9333).
// It tells the owner first with a macOS notification (what, about how long) and again
// when the run ends, whether it passes, fails or is stopped. It never waits for an
// answer and never stops the run.
// On 2026-10-20 at 17:08 a job-tracker verifier ran its own Playwright script
// against the agent Chrome with no notice while he was working, and its new
// browser contexts opened windows on his screen.
// So scripts/agent-chrome-gate owns port 9333 and refuses CDP from any process
// this helper did not declare, with an error that names this helper.
// A declaration is a file in ~/.local/state/agent-chrome/sessions/. The gate
// matches a client when it, or a process above it, is the declaring process or
// carries AGENT_CHROME_SESSION=<id> in its environment.
// Leases are for long-lived clients such as the chrome-devtools-axi bridge: no
// owning process, live until they expire, and the gate's sweep says done.
// When a session ends, the gate closes the tabs it opened. To leave one open
// for the owner, run `agent-chrome-session keep --what "why" <targetId>` from
// inside the session (or PUT /agent-chrome/keep/<targetId>?what=<why> on the
// gate); the done notice then says how many tabs were left for him. A raw-CDP
// script keeps the tab it opened like this:
//   const { targetId } = await cdp.send("Target.createTarget", { url, background: true });
//   const kept = await fetch(`http://127.0.0.1:9333/agent-chrome/keep/${targetId}?what=${encodeURIComponent("form for the owner to review")}`, { method: "PUT" });
//   // 404: the live gate predates keep and never closes session tabs, so the tab stays anyway.
//   if (!kept.ok && kept.status !== 404) throw new Error(`keep refused (${kept.status}): ${await kept.text()}`);
// Tests: tests/agent_chrome_session_test.cjs.
const { execFile, spawn, spawnSync } = require("node:child_process");
const { randomUUID } = require("node:crypto");
const fs = require("node:fs");
const { homedir } = require("node:os");
const { join } = require("node:path");

const ENV = "AGENT_CHROME_SESSION";
const TITLE = "Agent Chrome";
const USAGE = 'Usage: agent-chrome-session --minutes N --what "what it does" [--foreground] -- <command> [args...]\n'
  + "It notifies the owner before the command touches the agent Chrome and again when it ends.\n"
  + "When it ends, the gate closes the tabs the command opened, except kept ones.\n"
  + 'Keep a tab for the owner, from inside the session that opened it: agent-chrome-session keep --what "why" <targetId>\n';
const KEEP_USAGE = 'Usage: agent-chrome-session keep --what "why it stays open" <targetId>\n'
  + "Run it inside the session that opened the tab; the gate refuses any other tab.\n";
// Test hook only: tests point keep at a gate of their own.
// Tests set AGENT_CHROME_SESSION_TEST_GATE_URL to a dead port (tests/lib/agent-chrome-test-env.cjs);
// the runner and chrome-devtools-axi (its probe and the URL it hands the real
// binary) reach the gate through this one value. The verify-agent-board
// skill's board.mjs reads the same variable itself, because its copied test
// checkout cannot require this script.
const GATE_URL = process.env.AGENT_CHROME_SESSION_TEST_GATE_URL || "http://127.0.0.1:9333";

function stateDir(home = process.env.AGENT_CHROME_STATE_HOME || homedir()) {
  return join(home, ".local/state/agent-chrome/sessions");
}

// The gate's record of the tabs sessions opened and kept (agent-chrome-gate tabTracker).
function tabsFile(dir = stateDir()) {
  return join(dir, "../tabs.json");
}

// How many tabs a session kept for the owner, by the gate's record. A lease's id
// comes back each time, so only tabs kept since this one started count.
function keptBy({ id, started }, dir = stateDir()) {
  const saved = read(tabsFile(dir));
  return Array.isArray(saved?.kept) ? saved.kept.filter((record) => record?.session === id && record.at >= started).length : 0;
}

function checkSpec({ what, minutes }, { lease = false } = {}) {
  if (lease) {
    if (!Number.isFinite(minutes) || minutes <= 0) throw new Error("A lease must have a positive finite duration.");
  } else if (!Number.isInteger(minutes) || minutes < 1 || minutes > 120) throw new Error("--minutes must be a whole number from 1 to 120.");
  if (typeof what !== "string" || !what.trim() || what.length > 120) throw new Error("--what must say in under 120 characters what the run does (no personal data).");
}

function parseArgs(args) {
  const spec = { foreground: false };
  let i = 0;
  for (; i < args.length && args[i] !== "--"; i += 1) {
    if (args[i] === "--minutes") spec.minutes = /^\d+$/.test(args[i + 1] ?? "") ? Number(args[++i]) : NaN;
    else if (args[i] === "--what") spec.what = args[++i];
    else if (args[i] === "--foreground") spec.foreground = true;
    else throw new Error(`Unknown option ${args[i]}.\n${USAGE}`);
  }
  const command = args.slice(i + 1);
  if (args[i] !== "--" || command.length === 0) throw new Error(USAGE);
  try { checkSpec(spec); } catch (error) { throw new Error(`${error.message}\n${USAGE}`); }
  return { ...spec, command };
}

// A declaring process is always this user's, so a pid now owned by another
// user (EPERM) has been reused and counts as gone. Reuse by this user's own
// processes is not checked: the file goes when the run ends, or within one
// sweep of a SIGKILL, and macOS hands out pids in order.
function alive(pid) {
  try { process.kill(pid, 0); return true; }
  catch { return false; }
}

function isLive(declaration, now = Date.now()) {
  if (declaration.pid !== undefined && !alive(declaration.pid)) return false;
  return declaration.until === undefined || now < declaration.until;
}

function read(file) {
  try { return JSON.parse(fs.readFileSync(file, "utf8")); } catch { return null; }
}

function declarations(dir = stateDir()) {
  let names;
  try { names = fs.readdirSync(dir); } catch { return []; }
  return names.filter((name) => name.endsWith(".json")).map((name) => ({ file: join(dir, name), declaration: read(join(dir, name)) }))
    .filter((entry) => entry.declaration?.id);
}

function write(dir, declaration) {
  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
  const file = join(dir, `${declaration.id}.json`);
  const temporary = `${file}.${process.pid}.tmp`;
  fs.writeFileSync(temporary, JSON.stringify(declaration), { mode: 0o600 });
  fs.renameSync(temporary, file);
  return file;
}

// Only one process may end a declaration, so the done notice goes out once.
function claim(file) {
  try { fs.renameSync(file, `${file}.ending`); return `${file}.ending`; } catch { return null; }
}

function minutesSince(started, now = Date.now()) {
  const minutes = Math.round((now - started) / 60000);
  return minutes < 1 ? "under a minute" : `${minutes} min`;
}

function startMessage({ what, minutes, foreground }) {
  return `${what}. About ${minutes} min${foreground ? ", in a foreground tab you may need to click" : ", background tabs only"}.`;
}

function doneMessage({ what, started }, outcome, now = Date.now(), kept = 0) {
  const left = kept ? `, and left ${kept} tab${kept === 1 ? "" : "s"} open for you` : "";
  return `${what}: ${outcome} after ${minutesSince(started, now)}. Done with the agent Chrome${left}.`;
}

const NOTIFY = ["-e", "on run argv", "-e", "display notification (item 1 of argv) with title (item 2 of argv)", "-e", "end run"];

// Test hook only: tests set AGENT_CHROME_SESSION_TEST_NOTIFY_LOG so a run
// writes its notices to that file instead of the owner's screen.
const TEST_LOG = process.env.AGENT_CHROME_SESSION_TEST_NOTIFY_LOG;

function osascriptNotify(message) {
  if (TEST_LOG) return Promise.resolve(fs.appendFileSync(TEST_LOG, `${message}\n`));
  return new Promise((resolve, reject) => {
    execFile("/usr/bin/osascript", [...NOTIFY, message, TITLE], { timeout: 5000 }, (error) => (error ? reject(error) : resolve()));
  });
}

const defaults = {
  dir: () => stateDir(),
  notify: osascriptNotify,
  log: (message) => process.stderr.write(`agent-chrome-session: ${message}\n`),
  now: () => Date.now(),
};

async function tell(deps, message) {
  try { await deps.notify(message); }
  catch (error) { deps.log(`the notification failed (${error.message}); the run goes on.`); }
}

// The declaration that already covers this process, so nested helpers stay quiet.
function current(env = process.env, dir = stateDir()) {
  const id = env[ENV];
  if (!id) return null;
  const declaration = read(join(dir, `${id}.json`));
  return declaration && isLive(declaration) ? declaration : null;
}

const SIGNALS = { SIGINT: 2, SIGTERM: 15, SIGHUP: 1 };

// Declare a session owned by this process, tell the owner, run fn(env), tell him it ended.
// A signal ends the run through spec.onSignal(signal, count, stop) (the CLI
// forwards it to its child); without one, or when onSignal calls stop, the run
// is reported stopped and the process exits once the done notice is out.
// Inside a session that already covers this process, the outer one does the
// telling, but signals still go to onSignal: a terminal's Ctrl-C reaches every
// process in the group, and the Playwright runner must close its tab first.
async function withSession(spec, fn, deps = defaults) {
  checkSpec(spec);
  const dir = deps.dir();
  const nested = Boolean(current(process.env, dir));
  const declaration = nested ? null : { id: randomUUID(), what: spec.what.trim(), minutes: spec.minutes, foreground: Boolean(spec.foreground), pid: process.pid, started: deps.now() };
  const file = declaration && write(dir, declaration);
  let outcome = "stopped";
  // One ending, which a stop during the done notice waits for.
  let ending;
  const finish = () => {
    ending ??= (async () => {
      const owned = file && claim(file);
      if (!owned) return;
      await tell(deps, doneMessage(declaration, outcome, deps.now(), keptBy(declaration, dir)));
      fs.rmSync(owned, { force: true });
    })();
    return ending;
  };
  let signals = 0;
  const stop = (signal) => finish().finally(() => process.exit(128 + SIGNALS[signal]));
  const handlers = Object.keys(SIGNALS).map((signal) => {
    const handler = () => {
      signals += 1;
      if (spec.onSignal) spec.onSignal(signal, signals, stop);
      else stop(signal);
    };
    process.on(signal, handler);
    return [signal, handler];
  });
  try {
    if (nested) return await fn(process.env);
    await tell(deps, startMessage(declaration));
    const result = await fn({ ...process.env, [ENV]: declaration.id });
    outcome = spec.outcome ? spec.outcome(result) : "finished";
    return result;
  } catch (error) {
    outcome = signals || error.name === "AbortError" ? "stopped" : "failed";
    throw error;
  } finally {
    // The handlers stay until the done notice is out, so a signal in between
    // cannot kill the process before it.
    try { await finish(); } finally {
      for (const [signal, handler] of handlers) process.off(signal, handler);
    }
  }
}

// A lease for a client that outlives each command, such as the axi bridge.
// Synchronous, because the axi wrapper is. Renewing a live lease is silent; a
// new one tells the owner, after saying done for an expired one of the same id.
function lease({ id, what, minutes, foreground = false }, deps = syncDefaults) {
  checkSpec({ what, minutes }, { lease: true });
  const dir = deps.dir();
  const file = join(dir, `${id}.json`);
  const existing = read(file);
  const now = deps.now();
  const fresh = !(existing && isLive(existing, now));
  if (fresh && existing) endSync(file, existing, "finished", deps);
  const declaration = { id, what, minutes, foreground, started: fresh ? now : existing.started, until: now + minutes * 60000 };
  write(dir, declaration);
  if (fresh) tellSync(deps, startMessage(declaration));
  return declaration;
}

function endLease(id, deps = syncDefaults) {
  const file = join(deps.dir(), `${id}.json`);
  const declaration = read(file);
  if (declaration) endSync(file, declaration, "finished", deps);
}

function endSync(file, declaration, outcome, deps) {
  const owned = claim(file);
  if (!owned) return;
  tellSync(deps, doneMessage(declaration, outcome, Math.min(deps.now(), declaration.until ?? Infinity), keptBy(declaration, deps.dir())));
  fs.rmSync(owned, { force: true });
}

function tellSync(deps, message) {
  try { deps.notify(message); }
  catch (error) { deps.log(`the notification failed (${error.message}); the run goes on.`); }
}

const syncDefaults = {
  ...defaults,
  notify: (message) => {
    if (TEST_LOG) return fs.appendFileSync(TEST_LOG, `${message}\n`);
    const result = spawnSync("/usr/bin/osascript", [...NOTIFY, message, TITLE], { timeout: 5000 });
    if (result.status !== 0) throw new Error(result.error?.message ?? `osascript exited ${result.status}`);
  },
};

// A declaration the gate writes for a client that skipped this helper, during
// the migration window (scripts/agent-chrome-gate GRACE_UNTIL). the owner still
// hears about it first; how long is unknown, and the sweep says done when the
// client exits.
async function adopt({ pid, what }, deps = defaults) {
  const dir = deps.dir();
  const id = `adopted-${pid}`;
  const existing = read(join(dir, `${id}.json`));
  if (existing && isLive(existing, deps.now())) return { file: join(dir, `${id}.json`), declaration: existing };
  const declaration = { id, what, pid, adopted: true, foreground: false, started: deps.now() };
  const file = write(dir, declaration);
  await tell(deps, `${what} is using the agent Chrome without agent-chrome-session, so how long is unknown.`);
  return { file, declaration };
}

// Say done for declarations whose process died without saying so (SIGKILL) and
// for expired leases and adoptions. The gate runs this every few seconds.
async function sweep(deps = defaults, graceUntil = Infinity) {
  const now = deps.now();
  for (const { file, declaration } of declarations(deps.dir())) {
    if (isLive(declaration, now) && !(declaration.adopted && now >= graceUntil)) continue;
    const owned = claim(file);
    if (!owned) continue;
    const outcome = declaration.pid === undefined || declaration.adopted ? "finished" : "stopped without saying so";
    await tell(deps, doneMessage(declaration, outcome, Math.min(now, declaration.until ?? Infinity, declaration.adopted ? graceUntil : Infinity), keptBy(declaration, deps.dir())));
    fs.rmSync(owned, { force: true });
  }
}

// Without a terminal on stdin, as when an agent's harness runs the helper, the
// command gets a process group of its own, so a signal reaches everything it
// started exactly once, and a second one SIGKILLs all of it. A process outside
// the terminal's foreground group cannot read the terminal: it would stop at
// its first read, and with a session of its own it has no /dev/tty for
// password or passphrase prompts. So from a terminal the command stays in the
// terminal's group, where each Ctrl-C reaches every process directly and a
// second one SIGKILLs the command alone.
// The test is stdin alone. A person who pipes into the helper from a terminal
// (`cat x | agent-chrome-session ... -- cmd`) gets a group of its own, so the
// command loses /dev/tty and its prompts. Agents have no /dev/tty at all, so
// checking for one would gain nothing for them.
// A command that calls setsid itself, or spawns a detached child, leaves the
// group: neither the second signal's SIGKILL nor the watchdog reaches it. The
// gate still cuts its connections and closes its tabs once the session ends.
// A group of its own would let the command outlive a harness that SIGKILLs the
// helper's group, which used to take the command down too. A watchdog in a
// session of its own reads a pipe from the helper; if the pipe closes before
// the helper says the command ended, it SIGKILLs the command's group.
// The watchdog can only start once the command's group exists, so the command
// starts through a shell that waits on another pipe until the watchdog has the
// group. A SIGKILL between the two spawns closes that pipe too, and the shell
// exits before any of the command's code runs. bash rewrites PWD and drops
// OLDPWD and _, so env -i hands the command exactly the session's environment.
// The other two paths exec it through env -i too, so a command runs the same
// way on all three.
// Do not simplify the read loops here and in WATCHDOG back to `read`. Node's
// "pipe" is a socketpair, and libuv closes the helper's copy of the child's
// end right after the spawn. If anything inspects that fd at that moment
// (lsof does, and any agent may run it), XNU's
// fileproc_drain marks the socket SS_DRAINING for good. From then on a read
// that would block fails with EBADF, in every process, while a read that finds
// data or EOF still works. `read` cannot tell that error from EOF; dd's exit
// status can. So an error, while the fd is still open, waits and reads again,
// a bounded number of times, and never runs or kills anything.
const LAUNCHER = 'for w in 0.01 0.02 0.05 0.1 0.2 0.5 1 1 ""; do r=$(/bin/dd bs=1 count=1 status=none <&3 2>&1) && break; [ -n "$w" ] && { : <&3; } 2>/dev/null || { echo "agent-chrome-session: the command did not start: its release pipe could not be read (${r:-fd 3 closed}), retried for 3 s" >&2; exit 1; }; sleep "$w"; done; [ "$r" = r ] || exit 1; exec 3<&-; exec /usr/bin/env -i -- "$@"';
// The watchdog reads its pipe the same way. A byte means the command ended
// and EOF means the helper is gone. If the pipe still cannot be read after
// about 9 s, the watchdog exits 3 without killing anything, and the helper
// says that a SIGKILL of the helper will no longer stop the command.
const WATCHDOG = 'for w in 0.2 0.5 1 2 5 ""; do r=$(/bin/dd bs=1 count=1 status=none 2>&1) && break; [ -n "$w" ] && { : <&0; } 2>/dev/null || exit 3; sleep "$w"; done; [ -n "$r" ] || kill -s KILL -- "-$1" 2>/dev/null';

// env runs the command with execvp, so a script with no #! line runs through
// /bin/sh, as from a shell. Its failures come from env, so the command is
// looked up here first, as execvp does, and one that cannot run fails before
// anything is spawned, with the shell's exit codes and this helper's name.
// A file that goes away between this check and the exec still fails 127, with
// env's message. env reads a leading NAME=value operand as an assignment, so a
// command name with "=" in it would run nothing and print the environment.
function unrunnable(command, env) {
  if (command.includes("=")) return { code: 2, message: `command name may not contain "=": ${command}` };
  const candidates = command.includes("/") ? [command] : command ? (env.PATH ?? "/usr/bin:/bin").split(":").map((dir) => join(dir || ".", command)) : [];
  let found = false;
  for (const file of candidates) {
    let stat;
    try { stat = fs.statSync(file); } catch { continue; }
    found = true;
    if (!stat.isFile()) continue;
    try {
      fs.accessSync(file, fs.constants.X_OK);
      return null;
    } catch { /* found, but not executable */ }
  }
  return found ? { code: 126, message: `${command}: permission denied` } : { code: 127, message: `${command}: command not found` };
}
function lifeline(group, log) {
  const watchdog = spawn("/bin/sh", ["-c", WATCHDOG, "sh", String(group)], { detached: true, stdio: ["pipe", "ignore", "ignore"] });
  watchdog.once("error", () => {});
  watchdog.once("exit", (code) => {
    if (code === 3) log("the watchdog could not read its pipe (a drained socket, EBADF for 9 s), so a SIGKILL of this helper will not stop the command.");
  });
  watchdog.stdin.on("error", () => {});
  watchdog.unref();
  watchdog.stdin.unref();
  return () => new Promise((resolve) => watchdog.stdin.end("e", resolve));
}

// Asks the gate to leave a tab open after the session ends. The caller is
// identified as for CDP, so this must run inside the session that opened the
// tab; the gate's refusal says why it did not keep one.
async function keepTab(targetId, why, url = GATE_URL, timeout = 15000) {
  if (typeof targetId !== "string" || !targetId) throw new Error(`keep needs the tab's target id.\n${KEEP_USAGE}`);
  if (typeof why !== "string" || !why.trim() || why.length > 120) throw new Error(`--what must say in under 120 characters why the tab stays open (no personal data).\n${KEEP_USAGE}`);
  const answer = await fetch(`${url}/agent-chrome/keep/${encodeURIComponent(targetId)}?what=${encodeURIComponent(why.trim())}`, { method: "PUT", signal: AbortSignal.timeout(timeout) });
  const body = (await answer.text()).trim();
  // 404: the live gate predates keep and never closes session tabs, so the tab stays anyway.
  if (answer.status === 404) return "the gate predates keep and closes no session tabs, so this tab stays open anyway.";
  if (!answer.ok) throw new Error(body || `the gate answered ${answer.status} to keep.`);
  return body;
}

async function keepCommand(args, deps) {
  let why;
  const targets = [];
  for (let i = 0; i < args.length; i += 1) {
    if (args[i] === "--what") why = args[++i];
    else targets.push(args[i]);
  }
  if (targets.length !== 1 || why === undefined) throw new Error(KEEP_USAGE);
  if (!current(process.env, deps.dir())) throw new Error(`keep runs inside the session that opened the tab, and this process is in none.\n${KEEP_USAGE}`);
  process.stdout.write(`${await keepTab(targets[0], why)}\n`);
  return 0;
}

async function main(args, deps = defaults, stdinIsTerminal = Boolean(process.stdin.isTTY)) {
  if (args[0] === "keep") return keepCommand(args.slice(1), deps);
  const spec = parseArgs(args);
  const [command, ...rest] = spec.command;
  let child;
  let pending;
  // Set once a second signal SIGKILLs the command. killpg reaches the group's
  // members one at a time, so its shell can still exit 0 before its own SIGKILL.
  let killed = false;
  // Nested, the outer session has put this one in a group of its own, or in
  // the terminal's, so every signal also reaches the command directly, and only
  // the outer session SIGKILLs. From a terminal it kills only its own child,
  // this session, so a command here that ignores a real second Ctrl-C keeps
  // running; once the outer session has ended, the gate closes that command's
  // connections to the agent Chrome and its tabs.
  const nested = Boolean(current(process.env, deps.dir()));
  const grouped = !nested && !stdinIsTerminal;
  const send = (signal) => {
    try { process.kill(grouped ? -child.pid : child.pid, signal); } catch { /* already gone */ }
  };
  const code = await withSession({
    ...spec,
    // A signal during the start notice means the command never starts; a
    // second one kills a child that ignored the first. A Playwright runner
    // that is still creating its tab when that SIGKILL comes leaves the tab to
    // the gate, which closes it once the session has ended.
    onSignal: (signal, count, stop) => {
      if (!child && count > 1) stop(signal);
      else if (!child) pending = signal;
      else if (count === 1) send(signal);
      else if (!nested) {
        killed = true;
        send("SIGKILL");
      }
    },
    outcome: (status) => (status === 0 ? "finished" : status > 128 ? "stopped" : `failed (exit ${status})`),
  }, (env) => new Promise((resolve) => {
    if (pending) {
      resolve(128 + SIGNALS[pending]);
      return;
    }
    const refused = unrunnable(command, env);
    if (refused) {
      deps.log(refused.message);
      resolve(refused.code);
      return;
    }
    const vars = Object.entries(env).filter(([, value]) => value !== undefined).map(([name, value]) => `${name}=${value}`);
    if (grouped) child = spawn("/bin/sh", ["-c", LAUNCHER, "sh", ...vars, command, ...rest], { stdio: ["inherit", "inherit", "inherit", "pipe"], env: {}, detached: true });
    else child = spawn("/usr/bin/env", ["-i", "--", ...vars, command, ...rest], { stdio: "inherit", env: {} });
    const ended = grouped && child.pid ? lifeline(child.pid, deps.log) : async () => {};
    // Only now that the watchdog has the group may the command run.
    const release = child.stdio[3];
    if (release) {
      release.on("error", () => {});
      release.end("r");
    }
    child.once("error", (error) => { deps.log(error.message); ended().then(() => resolve(127)); });
    child.once("close", (status, signal) => {
      ended().then(() => resolve(killed ? 128 + 9 : status ?? 128 + (signal === "SIGKILL" ? 9 : signal === "SIGINT" ? 2 : 15)));
    });
  }), deps);
  return code;
}

module.exports = { ENV, SIGNALS, GATE_URL, stateDir, tabsFile, keptBy, keepTab, parseArgs, isLive, declarations, current, withSession, lease, endLease, adopt, sweep, startMessage, doneMessage, main };
if (require.main === module) {
  main(process.argv.slice(2)).then((code) => { process.exitCode = code; }, (error) => {
    process.stderr.write(`agent-chrome-session: ${error.message}${error.message.endsWith("\n") ? "" : "\n"}`);
    process.exitCode = 2;
  });
}
