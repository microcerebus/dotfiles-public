#!/usr/bin/env bash
# term-wiki - open the visual terminal field guide (cheatsheet-first HTML,
# Catppuccin Mocha, built 2026-07-06 via lavish; source of truth is this
# repo's docs/term-wiki.html - edit it and rerun, no build step).
#
# Companion surfaces:
#   docs/cheatsheet.md   terminal-readable, generated by `term-dojo cheatsheet`
#   term-dojo game       the interactive trainer for the same material
#
# A public copy is periodically published via `lavish-axi share` (the URL
# rotates on each publish; the local file here is always current).
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
WIKI="$DOTFILES/docs/term-wiki.html"

[[ -f "$WIKI" ]] || { echo "term-wiki: $WIKI not found" >&2; exit 1; }

WIKI_MD="$DOTFILES/docs/term-wiki.md"

case "${1:-}" in
  md|term|-t)
    # Terminal version: same content as markdown. nvim renders it nicely
    # (render-markdown); inside nvim it is also on <leader>ch.
    exec "${EDITOR:-nvim}" -R "$WIKI_MD"
    ;;
  cat)
    exec cat "$WIKI_MD"
    ;;
  edit|-e)
    exec "${EDITOR:-nvim}" "$WIKI"
    ;;
  path)
    echo "$WIKI"
    ;;
  *)
    # macOS default browser; file:// works - only the Mermaid/font CDNs
    # need network.
    exec open "$WIKI"
    ;;
esac
