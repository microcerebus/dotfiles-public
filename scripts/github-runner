#!/usr/bin/env bash
# github-runner: lifecycle of the self-hosted GitHub Actions runner that
# nix/github-runner.nix declares for job-tracker.
#
# Usage: github-runner <command> <config> [<new plist>]
#   start          launchd entry point, as the runner user: refuse to run if
#                  the isolation check fails, wipe all job state, register if a
#                  token is queued, then run the listener.
#   job-started    runner hook before every job: the isolation check again, so
#                  a job fails rather than run without it; then copy the pinned
#                  tools into the job's tool cache.
#   job-completed  runner hook after every job: wipe everything the job wrote,
#                  so one PR's run cannot leave state for the next.
#   check          isolation check: the runner user must not list or enter the
#                  owner's home, use sudo, be a trusted Nix user, or connect to
#                  any other user's listener on the tailnet, and must still
#                  reach its own servers on loopback. It only warns about the
#                  listeners it reaches on this Mac's loopback and LAN
#                  addresses, which pf on macOS cannot filter.
#   activate       activation, as root, before nix-darwin's launchd step,
#                  with the new system's plist for the runner: if launchd
#                  runs the runner, install the plist and leave the reload
#                  pending, so the switch does not cut off a running job.
#                  Never waits.
#   firewall       launchd entry point, as root, every minute: keep the pf
#                  rules behind the tailnet part (nix/github-runner.pf) loaded
#                  and pf enabled, then reload the runner if a reload is
#                  pending and two polls a minute apart found it idle.
#   register       run by the owner (github-runner-register): mint a one-hour
#                  registration token with gh and queue it for the runner,
#                  never printing it.
#
# <config> is the store file nix/github-runner.nix writes (url name labels bin
# state work home tmp tool seed inbox protected anchor rules loaded user
# label plist reload reload_status). Paths come from it, never from the
# environment: a job can rewrite HOME or TMPDIR for later steps through
# GITHUB_ENV, and the completed hook must not follow that.
# Tests: tests/github_runner_test.sh
# shellcheck disable=SC2154 # url, name and the paths come from <config>
set -euo pipefail
[ $# = 2 ] || { [ $# = 3 ] && [ "$1" = activate ]; } \
  || { echo "usage: github-runner start|job-started|job-completed|check|firewall|register <config>, or activate <config> <new plist>" >&2; exit 64; }
cmd="$1"
# shellcheck source=/dev/null
. "$2"

# unlock <path>: undo what keeps the runner user from deleting its own files
# in and under <path>. Jobs leave read-only trees (Go, Nix), and a job can
# lock what it leaves on purpose: the user flags uchg and uappnd (it cannot
# set system flags), a deny ACL, a directory closed to its owner. Neither
# this nor find -P follows a symlink: a link's own flags and ACL go, never
# its target's. Top down: find cannot start in a directory it may not read,
# so <path> itself is done first, by unlock_top. One node at a time where
# order or length demands it: a directory find could not read or enter
# (closed to its owner, or under an ACL that may deny that) is opened as
# find reaches it, before it descends, and a path of 1000 bytes or more
# (PATH_MAX is 1024) goes by its name relative to its directory
# (-execdir). The rest is batched (-exec +; macOS's find runs -execdir +
# once per directory it enters, so once per node in a tree of directories).
# No name reaches chflags or chmod as an option: macOS's find -execdir
# passes a bare name, so each goes as ./{}, and the batches get <path>'s
# absolute paths. A -- goes before the flags or mode, where BSD chflags and
# chmod stop reading options; after it they take -- for a file, and
# chmod -N takes no -- at all.
# Every find in the wipe runs with LC_ALL=C. The runner's plist sets
# LANG=en_US.UTF-8, where each ? matches a character, not a byte, so a path
# under multibyte names would pass PATH_MAX before it matched $long.
# Errors are left to the caller, which checks what stays.
unlock_top() {
  if [ -L "$1" ]; then
    /usr/bin/chflags -h nouchg,nouappnd "$1"
    /bin/chmod -h -N "$1"
  elif [ -e "$1" ]; then
    /usr/bin/chflags nouchg,nouappnd "$1"
    /bin/chmod -N "$1"
    if [ -d "$1" ]; then /bin/chmod u+rwx "$1"; fi
  fi 2>/dev/null || true
}
unlock() {
  local long
  long="$(printf '%1000s' '' | /usr/bin/tr ' ' '?')*"
  unlock_top "$1"
  LC_ALL=C /usr/bin/find -P "$1" -mindepth 1 \
    \( \( -type d \( ! -perm -0500 -o -acl \) -o -path "$long" \) \
      \( -flags +uchg,uappnd -execdir /usr/bin/chflags -h -- nouchg,nouappnd ./{} \; -o -true \) \
      \( -acl -type l -execdir /bin/chmod -h -N ./{} \; -o -true \) \
      \( -acl ! -type l -execdir /bin/chmod -N ./{} \; -o -true \) \
      \( -type d ! -perm -0700 -execdir /bin/chmod -h -- u+rwx ./{} \; -o -true \) \) \
    -o \( -type d \( -flags +uchg,uappnd -o ! -perm -0700 \) \
      -exec /bin/sh -c '/usr/bin/chflags -h -- nouchg,nouappnd "$@"; /bin/chmod -h -- u+rwx "$@"' sh {} + \) \
    -o \( -type l \( -flags +uchg,uappnd -o -acl \) \
      -exec /bin/sh -c '/usr/bin/chflags -h -- nouchg,nouappnd "$@"; /bin/chmod -h -N "$@"' sh {} + \) \
    -o \( ! -type d ! -type l \( -flags +uchg,uappnd -o -acl \) \
      -exec /bin/sh -c '/usr/bin/chflags -h -- nouchg,nouappnd "$@"; /bin/chmod -N "$@"' sh {} + \) \
    2>/dev/null || true
}

# What macOS's containermanagerd puts in the runner's home and the runner
# user may not change, relative to the home. The wipe leaves these and the
# directories on the way to them, and nothing else, in any job dir.
home_keeps=(Library/ContainerManager Library/Caches/com.apple.containermanagerd)

# empty <dir> [keep...]: delete everything inside <dir> except the named
# top-level entries, after unlocking all of <dir>, then set <dir> back to
# 0700. What stays is listed, not guessed from rm's errors: in the home,
# home_keeps and the directories on the way to them may stay, as real
# directories. Anything else that stays, at any depth, fails the wipe.
empty() {
  local dir="$1" keep path ok
  shift
  [ -d "$dir" ] || return 0
  # find never enters the top-level keeps or home_keeps; it lists the latter.
  local internal=(-false) may_stay=(-false) allowed=() kept=() left=() found=' '
  for keep in "$@"; do internal+=(-o -path "./$keep"); done
  if [ "$dir" = "$home" ]; then
    for keep in "${home_keeps[@]}"; do
      may_stay+=(-o -path "./$keep")
      path="./$keep"
      while allowed+=("$path") && path="${path%/*}" && [ "$path" != . ]; do :; done
    done
  fi
  unlock "$dir"
  if [ ! -r "$dir" ] || [ ! -w "$dir" ] || [ ! -x "$dir" ]; then
    echo "could not wipe: $dir" >&2
    return 1
  fi
  while IFS= read -r -d '' path; do
    /bin/rm -rf "${dir:?}/$path" 2>/dev/null || true
  done < <(cd "$dir" && LC_ALL=C /usr/bin/find . -mindepth 1 -maxdepth 1 ! \( "${internal[@]}" \) -print0)
  while IFS= read -r -d '' path; do
    case "$path" in
      ./*)
        ok=0
        for keep in ${allowed[@]+"${allowed[@]}"}; do [ "$path" != "$keep" ] || ok=1; done
        if [ "$ok" = 1 ] && [ -d "$dir/$path" ] && [ ! -L "$dir/$path" ]; then
          found+="$path "
        else
          left+=("$dir/${path#./}")
        fi
        ;;
      *) left+=("$dir, which find could not list in full") ;;
    esac
  done < <(cd "$dir" && LC_ALL=C /usr/bin/find . -mindepth 1 \( "${internal[@]}" \) -prune -o \( "${may_stay[@]}" \) -prune -print0 -o -print0 \
    || printf '%s\0' '?')
  for keep in "${home_keeps[@]}"; do
    case "$found" in *" ./$keep "*) kept+=("$dir/$keep") ;; esac
  done
  if [ "${#kept[@]}" != 0 ]; then echo "kept what the runner user may not change: ${kept[*]}"; fi
  if [ "${#left[@]}" != 0 ]; then
    # A job names what it leaves: none of its newlines reach the log.
    for path in "${left[@]:0:20}"; do echo "could not wipe: ${path//[$'\n\r']/?}" >&2; done
    if [ "${#left[@]}" -gt 20 ]; then echo "could not wipe: ${#left[@]} entries in all" >&2; fi
    return 1
  fi
  /bin/chmod 0700 "$dir"
}

# wipe_jobs [keep...]: empty the home, the temp dir and the work dir (all
# but its top-level <keep> entries), then exit if any of them failed. All
# three are tried: a leftover that pins the home must not also hand the
# next job this job's temp files and work dir, where the runner would trust
# an _actions .completed marker.
wipe_jobs() {
  local failed=0
  empty "$home" || failed=1
  empty "$tmp" || failed=1
  empty "$work" "$@" || failed=1
  if [ "$failed" = 1 ]; then exit 1; fi
}

# listeners: "address port" for every TCP listener of another user on this
# Mac. netstat sees every user's sockets; lsof, unprivileged, sees only this
# user's, whose ports are left out. A wildcard listener is probed on loopback,
# which is also the path (lo0) to this Mac's LAN addresses.
listeners() {
  local own
  # One line: BSD awk rejects a -v value with a newline in it.
  own="$(lsof -nP -a -u "$(id -u)" -iTCP -sTCP:LISTEN -Fn 2>/dev/null | sed -n 's/^n.*://p' | tr '\n' ' ')" || true
  netstat -an -p tcp | awk -v own="$own" '
    BEGIN { n = split(own, ports, " "); for (i = 1; i <= n; i++) mine[ports[i]] = 1 }
    $6 == "LISTEN" && $1 ~ /^tcp/ {
      dot = match($4, /\.[^.]*$/)
      addr = substr($4, 1, dot - 1)
      port = substr($4, dot + 1)
      if (port in mine) next
      if (addr != "*") { found(addr, port); next }
      if ($1 ~ /4/) found("127.0.0.1", port)
      if ($1 ~ /6/) found("::1", port)
    }
    function found(addr, port) { if (!seen[addr " " port]++) print addr, port }'
}

# tailnet <address>: whether the address is Tailscale's (100.64.0.0/10 or
# fd7a:115c:a1e0::/48).
tailnet() {
  local second
  case "$1" in
    fd7a:115c:a1e0:*) return 0 ;;
    100.*.*.*) second="${1#100.}" && second="${second%%.*}" && [ "$second" -ge 64 ] && [ "$second" -le 127 ] ;;
    *) return 1 ;;
  esac
}

# probe_listeners: no listener of another user on the tailnet may accept a
# connection from the runner user; pf blocks the tailnet, so one that does
# means the firewall is down. Traffic to this Mac's loopback and LAN addresses
# never reaches pf on macOS (2026-10-11), so a listener there that answers is
# a warning, not a failure: the owner accepted that gap. Finding nothing to
# probe fails: there is always at least launchd's sshd, so an empty list means
# the probe itself broke.
probe_listeners() {
  local addr port target probed=0 on_tailnet=() reached_tailnet=() reached_here=()
  while read -r addr port; do
    case "$addr" in *:*) target="[$addr]:$port" ;; *) target="$addr:$port" ;; esac
    probed=$((probed + 1))
    if tailnet "$addr"; then
      on_tailnet+=("$target")
      if nc -z -G 2 -w 2 "$addr" "$port" >/dev/null 2>&1; then reached_tailnet+=("$target"); fi
    elif nc -z -G 2 -w 2 "$addr" "$port" >/dev/null 2>&1; then
      reached_here+=("$target")
    fi
  done < <(listeners)
  if [ "$probed" = 0 ]; then
    echo "isolation FAILED: found no listeners of other users to probe" >&2
    return 1
  fi
  if [ "${#reached_here[@]}" != 0 ]; then
    echo "isolation warning: can connect to ${#reached_here[@]} listeners of other users on this Mac's own addresses, which pf cannot filter: ${reached_here[*]}" >&2
  fi
  if [ "${#reached_tailnet[@]}" != 0 ]; then
    echo "isolation FAILED: the runner user can connect to listeners of other users on the tailnet: ${reached_tailnet[*]}" >&2
    return 1
  fi
  if [ "${#on_tailnet[@]}" = 0 ]; then
    echo "isolation ok: no listeners of other users on the tailnet to probe"
  else
    echo "isolation ok: cannot connect to listeners of other users on the tailnet: ${on_tailnet[*]}"
  fi
}

# own_servers: the runner's own test servers must still work, on both
# loopback addresses.
own_servers() {
  python3 -c '
import socket
for family, host in ((socket.AF_INET, "127.0.0.1"), (socket.AF_INET6, "::1")):
    with socket.socket(family) as server:
        server.bind((host, 0))
        server.listen()
        socket.create_connection(server.getsockname()[:2], timeout=2).close()
'
}

check() {
  local failed=0
  # deny <what> <command...>: the command must fail for the runner user.
  deny() {
    local what="$1"
    shift
    if "$@" >/dev/null 2>&1; then
      echo "isolation FAILED: the runner user can $what" >&2
      failed=1
    else
      echo "isolation ok: cannot $what"
    fi
  }
  enter() ( cd "$1" )
  # Read before matching: grep -q exiting early would fail nix with SIGPIPE,
  # and pipefail would turn a trusted user into "ok".
  nix_trusted() {
    local info
    info="$(nix store info --json 2>/dev/null)" && grep -Eq '"trusted": ?(true|1)' <<<"$info"
  }
  deny "list $protected" ls "$protected"
  # Entering is what reaching anything below takes, world-readable or not.
  deny "enter $protected" enter "$protected"
  deny "run sudo" sudo -n true
  deny "act as a trusted Nix user" nix_trusted
  probe_listeners || failed=1
  if own_servers >/dev/null 2>&1; then
    echo "isolation ok: can still reach its own servers on 127.0.0.1 and [::1]"
  else
    echo "isolation FAILED: the runner user cannot reach its own servers on 127.0.0.1 and [::1]" >&2
    failed=1
  fi
  [ "$failed" = 0 ] || { echo "refusing to run jobs until this is fixed" >&2; return 1; }
}

# register_queued: register with the queued token, then delete it whatever
# happens. The current registration is set aside first (config.sh refuses to
# run over one) and restored if GitHub rejects the token, so a stale token
# never takes down a working runner.
register_queued() {
  local queued="$inbox/token" token previous="$state/.previous" f
  token="$(<"$queued")"
  rm -f "$queued"
  rm -rf "$previous"
  mkdir "$previous"
  for f in .runner .credentials .credentials_rsaparams; do
    if [ -e "$state/$f" ]; then mv "$state/$f" "$previous/"; fi
  done
  # The token goes in by environment, not argv, so ps never shows it.
  if ACTIONS_RUNNER_INPUT_TOKEN="$token" "$bin/config.sh" --unattended --disableupdate --replace \
    --url "$url" --name "$name" --labels "$labels" --work "$work"; then
    echo "registered as $name with labels $labels"
  else
    echo "registration failed (token expired or revoked?); keeping the previous registration, if any" >&2
    for f in .runner .credentials .credentials_rsaparams; do
      if [ -e "$previous/$f" ]; then mv -f "$previous/$f" "$state/"; fi
    done
  fi
  rm -rf "$previous"
}

# seed_tools: copy each tool in $seed (a store path laid out as
# @actions/tool-cache expects) into the job's tool cache at $tool, so
# setup-node finds it without the network. A copy, not a link: jobs write
# beside the tools (corepack enable puts pnpm next to node), and the store
# copy must stay as it is. Whatever is already there goes first, locks and
# all: a previous job could have changed it and locked it to outlive the
# wipe, so unlock lifts the locks first. A link or file on the way to it
# goes too, so the copy never lands outside the tree. If any of it cannot
# go, the job is refused, as check refuses one. The marker goes in last, so
# a copy cut short is a cache miss, never a broken hit. A tool that fails to
# copy only warns: setup-node then downloads it, as it did before.
seed_tools() {
  local marker rel dest p rest
  unlock_top "${work:?}"
  unlock "${tool:?}"
  for marker in "$seed"/*/*/*.complete; do
    [ -e "$marker" ] || continue
    rel="${marker#"$seed/"}"
    rel="${rel%.complete}"
    dest="$tool/$rel"
    p="$tool" rest="${rel%/*}"
    while :; do
      if [ -L "$p" ] || { [ -e "$p" ] && [ ! -d "$p" ]; }; then /bin/rm -f "$p" 2>/dev/null || true; fi
      if [ -L "$p" ] || { [ -e "$p" ] && [ ! -d "$p" ]; }; then
        echo "isolation FAILED: cannot delete $p, which an earlier job left; refusing to run jobs" >&2
        exit 1
      fi
      [ -n "$rest" ] || break
      p="$p/${rest%%/*}"
      case "$rest" in */*) rest="${rest#*/}" ;; *) rest='' ;; esac
    done
    /bin/rm -rf "$dest.complete" "$dest" 2>/dev/null || true
    if [ -e "$dest" ] || [ -L "$dest" ] || [ -e "$dest.complete" ] || [ -L "$dest.complete" ]; then
      echo "isolation FAILED: cannot delete $dest, which an earlier job left; refusing to run jobs" >&2
      exit 1
    fi
    if /bin/mkdir -p "${dest%/*}" && /bin/cp -R "$seed/$rel" "$dest" \
      && /bin/chmod -R u+w "$dest" && : >"$dest.complete"; then
      echo "tool cache: $rel from $seed"
    else
      echo "warning: could not copy $rel into the tool cache; setup-node will download it" >&2
      /bin/rm -rf "$dest" || true
    fi
  done
}

# Deferred reload. nix-darwin reloads a daemon whose plist changed in the
# middle of the switch, and a reload kills the job the runner is running.
# So activate installs a changed plist itself while launchd runs the runner
# (nix-darwin then sees nothing to do) and writes $reload.pending: the time
# of the first switch still waiting, then the new plist. The firewall daemon
# reloads the runner from the installed plist once two of its polls at least
# a minute apart found no job running (reload_when_idle). `dotfiles-autoupdate status` reads
# $reload.pending itself and alarms if it is 2 hours old, so a daemon that
# stopped polling is noticed too. Each poll is recorded in $reload_status,
# which status also reads: a failure is an alarm at once, and so is no good
# poll for 36 hours (activate starts the file). $reload is in /var/run,
# which a reboot clears: launchd then starts the runner from the installed
# plist, so nothing is pending any more.
#
# Idle is "no Runner.Worker process of the runner user". The listener starts
# one worker per job and it lives exactly as long as the job, hooks
# included, so it needs no log reading and cannot go stale the way a marker
# the hooks wrote would after a crash. The runner keeps no local job state,
# and GitHub's busy flag would need the network and an admin token root does
# not have. $reload.idle holds the time of the first idle poll since the
# last busy one; the reload waits for an idle poll at least a minute after
# it, which rides out the gap between back-to-back jobs, and a poll right
# after another (the daemon reloaded by a switch) is not a minute. A job
# that starts and ends between two polls goes unseen. An idle time later
# than now (the clock stepped back) counts as now. A job the listener takes
# in the moment between the last poll and the reload still dies, as every
# running job did before.
#
# Only a runner this daemon unloaded is loaded again: $reload.idle says
# "unloading" from just before the unload until the load succeeds. A runner
# found not loaded otherwise was stopped by hand and stays stopped. A runner
# found loaded under "unloading" outlived a daemon killed before the unload:
# its idle minute starts again.
loaded_runner() { launchctl print "system/$label" >/dev/null 2>&1; }

reload_when_idle() {
  local now seen state busy=0 failure='' installed ok
  now="$(date +%s)"
  if [ -e "$reload.pending" ]; then
    seen="$(cat "$reload.pending")"
    state="$(cat "$reload.idle" 2>/dev/null || true)"
    if [ "$state" = unloading ] && loaded_runner; then
      # Killed before the unload: the old plist still runs. Start over.
      state=''
      rm -f "$reload.idle"
    fi
    if [ "$state" = unloading ]; then
      : # the load below retries
    elif loaded_runner; then
      pgrep -U "$user" -f '/Runner[.]Worker( |$)' >/dev/null || busy=$?
      case "$busy" in
        0) rm -f "$reload.idle" ;;
        1)
          case "$state" in '' | *[!0-9]*) state='' ;; esac
          if [ -z "$state" ] || [ "$state" -gt "$now" ]; then
            state="$now"
            echo "$state" >"$reload.idle"
          fi
          if [ $((now - state)) -ge 60 ]; then
            echo unloading >"$reload.idle"
            launchctl unload "$plist" || true
            if loaded_runner; then
              echo "$state" >"$reload.idle"
              failure="deferred reload failed: launchctl could not unload the runner, which still runs its old plist; the next idle poll tries again"
            fi
          fi
          ;;
        *)
          rm -f "$reload.idle"
          failure="cannot tell whether a job is running (pgrep exited $busy), so the pending reload waits"
          ;;
      esac
    else
      rm -f "$reload.pending" "$reload.idle"
      echo "$(date '+%F %T') the runner was stopped by hand, so it stays stopped; its new plist $plist is in place for the next load"
    fi
    if [ "$(cat "$reload.idle" 2>/dev/null || true)" = unloading ]; then
      launchctl load "$plist" || true
      if loaded_runner; then
        # A switch that installed a newer plist meanwhile keeps its marker.
        [ "$(cat "$reload.pending" 2>/dev/null)" != "$seen" ] || rm -f "$reload.pending"
        rm -f "$reload.idle"
        echo "$(date '+%F %T') reloaded the runner from $plist"
      else
        failure="deferred reload failed: launchd has not loaded $plist"
      fi
    fi
  fi
  if [ -n "$failure" ] && ! grep -qxF "fail	$failure" "$reload_status" 2>/dev/null; then
    echo "$(date '+%F %T') $failure" >&2
  fi
  # The format of dotfiles-autoupdate's status files, which it reads.
  installed="$(awk -F '\t' '$1 == "installed" { print $2; exit }' "$reload_status" 2>/dev/null || true)"
  ok="$(awk -F '\t' '$1 == "ok" { print $2; exit }' "$reload_status" 2>/dev/null || true)"
  [ -n "$failure" ] || ok="$now"
  {
    printf 'installed\t%s\n' "${installed:-$now}"
    [ -z "$ok" ] || printf 'ok\t%s\n' "$ok"
    printf 'ran\t%s\n' "$now"
    [ -z "$failure" ] || printf 'fail\t%s\n' "$failure"
  } >"$reload_status.new" && chmod 644 "$reload_status.new" && mv -f "$reload_status.new" "$reload_status" \
    || echo "$(date '+%F %T') could not write $reload_status" >&2
}

case "$cmd" in
  start)
    echo "=== $(date '+%F %T') github-runner start"
    check
    wipe_jobs
    # config.sh and the listener read RUNNER_ROOT; jobs inherit HOME and TMPDIR.
    export RUNNER_ROOT="$state" HOME="$home" TMPDIR="$tmp"
    if [ -s "$inbox/token" ]; then register_queued; fi
    if [ ! -f "$state/.runner" ]; then
      echo "not registered: run github-runner-register as the owner; this service starts again when the token lands"
      exit 0
    fi
    exec "$bin/Runner.Listener" run --startuptype service
    ;;
  job-started)
    check
    seed_tools
    ;;
  job-completed)
    PATH=/usr/bin:/bin
    # A Node in the tool cache that the seed lacks means setup-node downloaded
    # it: job-tracker's .node-version moved and the pin did not. Say so in the
    # job's annotations, before the wipe removes the evidence.
    pins="$(cd "$seed/node" 2>/dev/null && echo * || true)"
    for dir in "$tool"/node/*/; do
      [ -d "$dir" ] || continue
      dir="${dir%/}"
      [ -e "$seed/node/${dir##*/}" ] && continue
      echo "::warning::setup-node downloaded node ${dir##*/}; the runner seeds ${pins:-nothing}; bump node in nix/github-runner.nix"
    done
    # _temp and _PipelineMapping belong to the runner, which resets them per job.
    wipe_jobs _temp _PipelineMapping
    echo "wiped job state: $home, $tmp, $work"
    ;;
  check)
    check
    ;;
  activate)
    # No wait, lock or network here: activation runs under the switch lock.
    new="$3"
    if [ ! -e "$reload_status" ]; then
      printf 'installed\t%s\n' "$(date +%s)" >"$reload_status" && chmod 644 "$reload_status" || true
    fi
    if cmp -s "$new" "$plist"; then
      : # unchanged: nix-darwin has nothing to do either
    elif [ -f "$plist" ] && loaded_runner; then
      since='' pending_plist=''
      { read -r since pending_plist <"$reload.pending"; } 2>/dev/null || true
      # The marker names the plist its switch installed. If that is not the
      # installed one, a system without this step (a rollback, or a push that
      # reverted it) has installed and loaded another since: start afresh.
      if [ -n "$since" ] && ! cmp -s "$pending_plist" "$plist"; then
        since=''
        rm -f "$reload.idle"
      fi
      tmp_plist="${plist%/*}/.${plist##*/}.new"
      # Marker first: a failure either way leaves the old plist installed and
      # no marker, so nix-darwin's step sees the change and reloads the runner.
      if ! echo "${since:-$(date +%s)} $new" >"$reload.pending"; then
        rm -f "$reload.pending" "$reload.idle" 2>/dev/null || true
        echo "github-runner: could not write $reload.pending" >&2
        exit 1
      fi
      if ! { cp -f "$new" "$tmp_plist" && chmod 0644 "$tmp_plist" && mv -f "$tmp_plist" "$plist"; }; then
        rm -f "$tmp_plist" "$reload.pending" "$reload.idle"
        echo "github-runner: could not install the runner's new plist" >&2
        exit 1
      fi
      echo "github-runner: installed the runner's new plist; the github-runner-firewall daemon reloads the runner once no job is running" >&2
    else
      # Nothing loaded to cut off: nix-darwin's launchd step loads it next.
      rm -f "$reload.pending" "$reload.idle"
    fi
    ;;
  firewall)
    # Loads the rules into $anchor, a child of the com.apple anchor that the
    # stock /etc/pf.conf evaluates, and never touches the main ruleset, which
    # system services add anchors to at runtime. Says nothing unless it
    # changes something.
    main="$(pfctl -s rules 2>/dev/null)" || true
    if ! grep -qF 'anchor "com.apple/*"' <<<"$main"; then
      echo "$(date '+%F %T') pf's main ruleset has no com.apple anchor (still booting?); not loading" >&2
      exit 1
    fi
    current="$(pfctl -a "$anchor" -s rules 2>/dev/null)" || true
    if [ -z "$current" ] || [ "$(cat "$loaded" 2>/dev/null)" != "$rules" ]; then
      pfctl -q -a "$anchor" -f "$rules"
      echo "$rules" >"$loaded"
      echo "$(date '+%F %T') loaded $rules into pf anchor $anchor"
    fi
    info="$(pfctl -s info 2>/dev/null)" || true
    if ! grep -q '^Status: Enabled' <<<"$info"; then
      # Takes an enable reference, as /etc/pf.conf asks every pf user to.
      pfctl -q -E
      echo "$(date '+%F %T') enabled pf"
    fi
    # After pf, so nothing here can keep the rules from loading.
    reload_when_idle
    ;;
  register)
    if [ ! -d "$inbox" ] || [ ! -w "$inbox" ]; then
      echo "no writable token inbox at $inbox; run rebuild first, which creates the runner" >&2
      exit 1
    fi
    # The inbox's group is the runner's, and new files inherit it, so 0640
    # lets the runner read the token and nobody else.
    umask 077
    queued="$(mktemp "$inbox/.token.XXXXXX")"
    if ! gh api -X POST "repos/${url#https://github.com/}/actions/runners/registration-token" \
      --jq .token >"$queued" || [ ! -s "$queued" ]; then
      rm -f "$queued"
      echo "gh could not mint a registration token (needs admin on ${url#https://github.com/})" >&2
      exit 1
    fi
    chmod 0640 "$queued"
    mv "$queued" "$inbox/token"
    echo "token queued (valid for one hour); a waiting runner registers within a minute, a running one at its next start"
    ;;
  *)
    echo "unknown command: $cmd" >&2
    exit 64
    ;;
esac
