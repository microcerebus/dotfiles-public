#!/usr/bin/env node
// Owns 127.0.0.1:9333, the agent Chrome's DevTools address, and forwards to the
// Chrome itself on 127.0.0.1:9334 (launchd agents in nix/user.nix).
// the owner is told before any agent uses the agent Chrome, and again when it is
// done (2026-10-20 17:08, after a job-tracker verifier used it with no notice
// while he was working). scripts/agent-chrome-session sends those
// notifications, so this gate refuses CDP from any process that helper did not
// declare, and the refusal names the helper. Only the version probes
// (/json/version, /json/protocol) pass undeclared, because readiness checks and
// Playwright's first request use them; the tab list would show the owner's tabs.
// The agent Chrome is one headed window on his screen. That verifier's
// browser.newContext() calls each opened a new window there, and foreground
// tabs raise the window over his work. So inside a declared session the gate
// also refuses new browser contexts, new windows, tab activation, window
// resizing and Browser.close, and turns new tabs into background tabs, unless
// the session was declared with --foreground.
// When a session ends, the gate closes the tabs it opened and only those, so a
// run that is killed while its tab is still opening leaves nothing behind. It
// learns each tab from Chrome's answer to Target.createTarget (or /json/new),
// and keeps the Chrome side of a connection open for answers still due after
// the client has gone. The list survives a restart in tabs.json beside the
// declarations.
// A tab left for the owner on purpose (a form to review, a sign-in he finishes)
// is kept with PUT /agent-chrome/keep/<targetId>?what=<why> from inside the
// session that opened it, which the runner's keep(tab, why) and
// `agent-chrome-session keep` call. The gate never closes a kept tab, and
// refuses to keep a tab the session did not open. A keep from a process in no
// live session is refused without adopting it, so the owner gets no notice.
// It reads the client's process and environment with netstat and ps; it never
// logs them beyond the executable name.
// Tests: tests/agent_chrome_gate_test.cjs.
const { execFile } = require("node:child_process");
const fs = require("node:fs");
const http = require("node:http");
const net = require("node:net");
const { basename, join } = require("node:path");
const { promisify } = require("node:util");
const session = require("./agent-chrome-session");
const execute = promisify(execFile);

const LISTEN_PORT = 9333;
const CHROME_PORT = 9334;
const PROBES = new Set(["/json/version", "/json/protocol"]);
const HELPER = "~/dotfiles/scripts/agent-chrome-session";
// Migration window: until this date a client that skipped the helper is let
// through and the owner is notified on its behalf, so callers written before the
// gate keep working while they move to the helper. After it, they are refused.
const GRACE_UNTIL = Date.parse("2026-11-20T00:00:00+08:00");

function refusal(client) {
  return `agent-chrome-gate: refused. the owner is told before any agent uses the agent Chrome, and this process did not tell him.
Run the command through the helper, which sends the macOS notifications and then lets it through:
  ${HELPER} --minutes N --what "what it does" -- <your command>
For a written Playwright flow in a background tab: ~/dotfiles/scripts/agent-chrome-playwright --minutes N --what "..." flow.cjs
Client: ${client}. Rules: ~/dotfiles/AGENTS.md (agent Chrome).
`;
}

const SCREEN = "The agent Chrome is one window on the owner's screen, shared by every agent.";
const REFUSALS = {
  context: `agent-chrome-gate: refused Target.createBrowserContext. ${SCREEN} A new browser context opens a new window there (a job-tracker verifier did this on 2026-10-20). For isolated sign-ins, launch your own headless browser (chromium.launch({ headless: true })). For the agent Chrome's sign-ins, use a background tab in the default context: ~/dotfiles/scripts/agent-chrome-playwright.`,
  window: `agent-chrome-gate: refused a new window. ${SCREEN} Open a background tab instead (Target.createTarget with background: true), or declare the session with --foreground if the owner has to see or click the page.`,
  front: `agent-chrome-gate: refused bringing a tab to the front. ${SCREEN} Work in your background tab; declare the session with --foreground only if the owner has to see or click the page.`,
  resize: `agent-chrome-gate: refused Browser.setWindowBounds. ${SCREEN} Size only your own tab with Emulation.setDeviceMetricsOverride (Playwright: page.setViewportSize).`,
  close: `agent-chrome-gate: refused Browser.close. ${SCREEN} Disconnect instead (Playwright's browser.close() on a connectOverCDP browser only disconnects).`,
  wrapped: "agent-chrome-gate: refused Target.sendMessageToTarget, the deprecated way to reach a tab, which the gate cannot read. Put sessionId on the command instead (flattened sessions, as Playwright and Puppeteer do).",
};

// What to do with one CDP command from a declared session.
function policy(message, declaration) {
  const foreground = Boolean(declaration.foreground);
  const params = message.params ?? {};
  switch (message.method) {
    case "Target.createBrowserContext": return { refuse: REFUSALS.context };
    case "Target.createTarget":
      if (foreground) return {};
      if (params.newWindow) return { refuse: REFUSALS.window };
      return params.background === true ? {} : { rewrite: { ...message, params: { ...params, background: true } } };
    case "Target.activateTarget":
    case "Page.bringToFront":
      return foreground ? {} : { refuse: REFUSALS.front };
    case "Browser.setWindowBounds": return { refuse: REFUSALS.resize };
    case "Browser.close": return { refuse: REFUSALS.close };
    case "Target.sendMessageToTarget": return { refuse: REFUSALS.wrapped };
    default: return {};
  }
}

// WebSocket frames (RFC 6455). Returns null until the whole header is in.
function frameHeader(buffer) {
  if (buffer.length < 2) return null;
  let length = buffer[1] & 0x7f;
  let offset = 2;
  if (length === 126) {
    if (buffer.length < 4) return null;
    length = buffer.readUInt16BE(2);
    offset = 4;
  } else if (length === 127) {
    if (buffer.length < 10) return null;
    length = Number(buffer.readBigUInt64BE(2));
    offset = 10;
  }
  const masked = (buffer[1] & 0x80) !== 0;
  const size = offset + (masked ? 4 : 0);
  if (buffer.length < size) return null;
  return {
    fin: (buffer[0] & 0x80) !== 0,
    rsv: buffer[0] & 0x70,
    opcode: buffer[0] & 0x0f,
    mask: masked ? buffer.subarray(offset, offset + 4) : null,
    size,
    length,
  };
}

function unmask(payload, mask) {
  if (!mask) return Buffer.from(payload);
  const out = Buffer.alloc(payload.length);
  for (let i = 0; i < payload.length; i += 1) out[i] = payload[i] ^ mask[i % 4];
  return out;
}

function encodeFrame(text, mask) {
  const payload = Buffer.from(text);
  const length = payload.length;
  const extended = length < 126 ? 0 : length < 65536 ? 2 : 8;
  const header = Buffer.alloc(2 + extended + (mask ? 4 : 0));
  header[0] = 0x81;
  header[1] = (mask ? 0x80 : 0) | (extended === 0 ? length : extended === 2 ? 126 : 127);
  if (extended === 2) header.writeUInt16BE(length, 2);
  if (extended === 8) header.writeBigUInt64BE(BigInt(length), 2);
  if (!mask) return Buffer.concat([header, payload]);
  mask.copy(header, 2 + extended);
  return Buffer.concat([header, unmask(payload, mask)]);
}

// Passes frames through as bytes arrive. Single-frame text messages up to
// INSPECT_LIMIT are held whole and handed to onText, which returns the bytes
// to send instead. Fragmented and larger frames pass untouched: this is a
// guardrail against copied patterns, not a sandbox.
const INSPECT_LIMIT = 1 << 20;
class FrameStream {
  // wants() says whether to hold frames for onText at all, so a direction
  // the gate reads only now and then is not held up the rest of the time.
  constructor(write, onText = null, wants = () => true) {
    this.write = write;
    this.onText = onText;
    this.wants = wants;
    this.header = Buffer.alloc(0);
    this.remaining = 0;
    this.held = null;
    this.waiting = [];
  }

  // Bytes to send between frames, such as an error reply.
  inject(bytes) {
    if (this.remaining === 0 && this.header.length === 0 && !this.held) this.write(bytes);
    else this.waiting.push(bytes);
  }

  boundary() {
    for (const bytes of this.waiting.splice(0)) this.write(bytes);
  }

  push(chunk) {
    let i = 0;
    while (i < chunk.length) {
      if (this.remaining > 0) {
        const piece = chunk.subarray(i, i + this.remaining);
        i += piece.length;
        this.remaining -= piece.length;
        if (this.held) this.held.parts.push(piece);
        else this.write(piece);
        if (this.remaining === 0) this.end();
        continue;
      }
      this.header = Buffer.concat([this.header, chunk.subarray(i, i + 1)]);
      i += 1;
      const header = frameHeader(this.header);
      if (!header) continue;
      const bytes = this.header;
      this.header = Buffer.alloc(0);
      this.remaining = header.length;
      if (this.onText && header.fin && header.opcode === 1 && header.rsv === 0 && header.length <= INSPECT_LIMIT && this.wants()) {
        this.held = { header, bytes, parts: [] };
      } else {
        this.write(bytes);
      }
      if (this.remaining === 0) this.end();
    }
  }

  end() {
    if (this.held) {
      const { header, bytes, parts } = this.held;
      this.held = null;
      const payload = Buffer.concat(parts);
      const replacement = this.onText(unmask(payload, header.mask).toString("utf8"), header.mask);
      this.write(replacement ?? Buffer.concat([bytes, payload]));
    }
    this.boundary();
  }
}

// Client side of a CDP WebSocket: apply the policy to each command.
function filterCommand(text, mask, declaration, reply, log) {
  let message;
  try { message = JSON.parse(text); } catch { return null; }
  if (!message || typeof message.method !== "string") return null;
  const decision = policy(message, declaration.current());
  if (decision.rewrite) return encodeFrame(JSON.stringify(decision.rewrite), mask);
  if (!decision.refuse) return null;
  log(`refused ${message.method} for "${declaration.what}"`);
  const answer = { id: message.id, error: { code: -32000, message: decision.refuse } };
  if (message.sessionId) answer.sessionId = message.sessionId;
  reply(encodeFrame(JSON.stringify(answer), null));
  return Buffer.alloc(0);
}

// --- Who is connecting -----------------------------------------------------

// netstat and ps run once per connection; a hung one must not hold the client.
// SIGKILL, because execFile sends its kill signal once at the timeout and
// never escalates: a lookup that ignored SIGTERM would hold the client.
const PROBE = { timeout: 3000, killSignal: "SIGKILL", maxBuffer: 16 << 20 };
const NETSTAT = ["-anvW", "-f", "inet", "-p", "tcp"];

// The pid on the client's end of the connection, from the kernel's TCP table:
// netstat -v reads it through the net.inet.tcp.pcblist_n sysctl and prints
// each socket's last pid, the process that last connected, sent or received
// on it. Do not go back to lsof here. lsof opens every fd of every process
// with proc_pidfdinfo, and the iocount that takes can drain a socketpair
// that another process is handing to its child at that moment, anywhere on
// this Mac (XNU fileproc_drain; tests/agent_chrome_session_drain_test.py).
// The gate ran it for every connection. A failed or timed-out netstat gives
// no pid, so the client is refused, never guessed from partial output.
async function clientPid({ remotePort, localPort }, run = execute) {
  let stdout;
  try { ({ stdout } = await run("/usr/sbin/netstat", NETSTAT, PROBE)); }
  catch { return null; }
  const lines = stdout.split("\n");
  // Process names can contain spaces, so the owner is everything between the
  // fixed columns before and after it, as the header places it. The header
  // splits "Local Address" and "Foreign Address" into two words each.
  const header = lines.find((line) => line.startsWith("Proto "))?.trim().split(/\s+/) ?? [];
  const column = header.indexOf("process:pid");
  if (column < 0 || header[4] !== "Address" || header[6] !== "Address") return null;
  const before = column - 2;
  const after = header.length - column - 1;
  for (const line of lines) {
    const words = line.trim().split(/\s+/);
    if (words[0] !== "tcp4" || words.length < before + after + 1) continue;
    if (words[3] !== `127.0.0.1.${remotePort}` || words[4] !== `127.0.0.1.${localPort}` || words[5] !== "ESTABLISHED") continue;
    const owner = /:(\d+)$/.exec(words.slice(before, words.length - after).join(" "));
    const pid = owner ? Number(owner[1]) : 0;
    return pid > 0 && pid !== process.pid ? pid : null;
  }
  return null;
}

// The client and the processes above it: pid, environment tokens, executable
// name and, for the client, the script it runs. Three ps calls whatever the
// depth: the process table for the ancestry, the chain's environments (ps -E
// appends them as KEY=value words), and the client's arguments without them,
// so an environment value never becomes its name.
async function chain(pid, run = execute) {
  const table = new Map();
  try {
    const { stdout } = await run("/bin/ps", ["-A", "-o", "pid=,ppid=,uid=,comm="], PROBE);
    for (const line of stdout.split("\n")) {
      const found = /^\s*(\d+)\s+(\d+)\s+(\d+)\s(.*)$/.exec(line);
      if (found) table.set(Number(found[1]), { ppid: Number(found[2]), uid: Number(found[3]), comm: found[4].trim() });
    }
  } catch { return []; }
  const pids = [];
  for (let current = pid; current > 1 && table.has(current) && pids.length < 32; current = table.get(current).ppid) pids.push(current);
  if (pids.length === 0) return [];
  const environments = new Map();
  try {
    const { stdout } = await run("/bin/ps", ["-E", "-ww", "-o", "pid=,command=", "-p", pids.join(",")], PROBE);
    for (const line of stdout.split("\n")) {
      const found = /^\s*(\d+)\s(.*)$/.exec(line);
      if (found) environments.set(Number(found[1]), found[2]);
    }
  } catch { /* no tokens: only the declaring pid can match */ }
  let script;
  try {
    const { stdout } = await run("/bin/ps", ["-ww", "-o", "args=", "-p", String(pid)], PROBE);
    script = stdout.trim().split(/\s+/).slice(1).find((word) => /\.[cm]?[jt]s$/.test(word));
  } catch { /* name without the script */ }
  return pids.map((current, index) => ({
    pid: current,
    uid: table.get(current).uid,
    tokens: [...(environments.get(current) ?? "").matchAll(new RegExp(`(?:^|\\s)${session.ENV}=(\\S+)`, "g"))].map((found) => found[1]),
    command: basename(table.get(current).comm),
    script: index === 0 && script ? basename(script) : undefined,
  }));
}

// Adopted declarations stand only for the migration window.
function usable(declaration, now, graceUntil) {
  return session.isLive(declaration, now) && !(declaration.adopted && now >= graceUntil);
}

function match(processes, entries, now = Date.now(), graceUntil = GRACE_UNTIL) {
  for (const { pid, tokens } of processes) {
    for (const { file, declaration } of entries) {
      if (!usable(declaration, now, graceUntil)) continue;
      if (declaration.pid === pid || tokens.includes(declaration.id)) return { file, declaration };
    }
  }
  return null;
}

// A connection's view of its declaration. The policy reads the latest copy;
// live() is false once the session has ended, and the gate then closes the
// connection, so a client left running after its helper died loses Chrome.
function reader(found, graceUntil = GRACE_UNTIL) {
  let latest = found.declaration;
  const read = () => { try { return JSON.parse(fs.readFileSync(found.file, "utf8")); } catch { return null; } };
  return {
    id: latest.id,
    file: found.file,
    what: latest.what,
    current: () => {
      latest = read() ?? latest;
      return latest;
    },
    live: (now = Date.now()) => {
      const declaration = read();
      return Boolean(declaration) && usable(declaration, now, graceUntil);
    },
  };
}

async function identify(socket, deps = {}) {
  const pid = await clientPid(socket, deps.run);
  const unknown = { client: "an unknown process (not this user's, gone, or the lookup failed)" };
  if (!pid) return unknown;
  const processes = await chain(pid, deps.run);
  // netstat lists every user's sockets, where lsof saw only this user's. A
  // client run by another user (the GitHub runner's) or one ps cannot place
  // stays unknown, so the migration window never adopts it.
  if (processes[0]?.uid !== process.getuid()) return unknown;
  const graceUntil = deps.graceUntil ?? GRACE_UNTIL;
  const found = match(processes, session.declarations(deps.dir ?? session.stateDir()), Date.now(), graceUntil);
  const client = `${processes[0]?.command ?? "unknown"} (pid ${pid})`;
  const name = [processes[0]?.command, processes[0]?.script].filter(Boolean).join(" ") || "an unknown process";
  return found ? { client, pid, name, declaration: reader(found, graceUntil) } : { client, pid, name };
}

// --- Tabs a session opened ---------------------------------------------------

// Closing one tab through Chrome's HTTP endpoint, which needs no WebSocket.
// True if Chrome closed it; false if it was already gone.
function closeTab(chromePort, targetId, timeout = 3000) {
  return new Promise((resolve, reject) => {
    const request = http.get({ host: "127.0.0.1", port: chromePort, path: `/json/close/${encodeURIComponent(targetId)}`, timeout }, (answer) => {
      answer.resume();
      if (answer.statusCode === 200) resolve(true);
      else if (answer.statusCode === 404) resolve(false);
      else reject(new Error(`Chrome answered ${answer.statusCode}`));
    });
    request.once("timeout", () => request.destroy(new Error(`no answer within ${timeout / 1000}s`)));
    request.once("error", reject);
  });
}

// The ids of the tabs Chrome has open, through its HTTP endpoint.
function listTabs(chromePort, timeout = 3000) {
  return new Promise((resolve, reject) => {
    const request = http.get({ host: "127.0.0.1", port: chromePort, path: "/json/list", timeout }, (answer) => {
      const body = [];
      answer.on("data", (chunk) => body.push(chunk));
      answer.once("end", () => {
        try { resolve(new Set(JSON.parse(Buffer.concat(body).toString("utf8")).map((target) => target.id))); }
        catch (error) { reject(error); }
      });
    });
    request.once("timeout", () => request.destroy(new Error(`no answer within ${timeout / 1000}s`)));
    request.once("error", reject);
  });
}

// The tabs each session opened, by declaration, closed once it has ended,
// and the tabs sessions kept for the owner, which the gate never closes.
// A session may keep only a tab in its own set; keeping moves it out of the
// set, so a later session that drives the tab never takes it over. A kept
// record goes once Chrome no longer lists the tab.
// Declarations that are files are saved to file, so a restarted gate still
// closes them; the tests' declarations have no file and stay in memory.
// The file is { sessions: [...], kept: [{ targetId, what, session, at }] };
// a bare array, as the gate wrote before keeping, is the sessions.
function tabTracker({ chromePort, file = null, graceUntil = GRACE_UNTIL, log = () => {}, close = closeTab, list = listTabs, now = Date.now } = {}) {
  const sessions = new Map();
  const kept = new Map();
  const save = () => {
    if (!file) return;
    const saved = {
      sessions: [...sessions.values()].filter((entry) => entry.file).map(({ id, file: declaration, what, targets }) => ({ id, file: declaration, what, targets: [...targets] })),
      kept: [...kept.values()],
    };
    try {
      fs.mkdirSync(join(file, ".."), { recursive: true, mode: 0o700 });
      fs.writeFileSync(`${file}.tmp`, JSON.stringify(saved), { mode: 0o600 });
      fs.renameSync(`${file}.tmp`, file);
    } catch (error) { log(`could not save the session tabs: ${error.message}`); }
  };
  if (file) {
    let saved = [];
    try { saved = JSON.parse(fs.readFileSync(file, "utf8")); } catch { /* none yet */ }
    const savedSessions = Array.isArray(saved) ? saved : saved?.sessions;
    for (const { id, file: declaration, what, targets } of Array.isArray(savedSessions) ? savedSessions : []) {
      if (typeof id !== "string" || typeof declaration !== "string" || !Array.isArray(targets)) continue;
      sessions.set(id, { id, file: declaration, what, targets: new Set(targets), live: reader({ file: declaration, declaration: { id, what } }, graceUntil).live });
    }
    for (const record of Array.isArray(saved?.kept) ? saved.kept : []) {
      if (typeof record?.targetId === "string") kept.set(record.targetId, record);
    }
  }
  return {
    opened(declaration, targetId) {
      if (typeof targetId !== "string" || !targetId) return;
      const key = declaration.id ?? declaration;
      if (!sessions.has(key)) sessions.set(key, { id: declaration.id, file: declaration.file, what: declaration.what, targets: new Set(), live: declaration.live });
      sessions.get(key).targets.add(targetId);
      save();
    },
    // Leaves a tab the session opened open after it ends. False if the tab is
    // not in that session's set. A repeat keep by the same session, such as a
    // retry after a lost answer, is true again.
    keep(declaration, targetId, what) {
      if (declaration.id !== undefined && kept.get(targetId)?.session === declaration.id) return true;
      const entry = sessions.get(declaration.id ?? declaration);
      if (!entry?.targets.delete(targetId)) return false;
      kept.set(targetId, { targetId, what, session: declaration.id, at: now() });
      save();
      log(`kept a tab of "${declaration.what}" open for the owner: ${what}`);
      return true;
    },
    // Closes the tabs of every session that has ended, and forgets kept tabs
    // Chrome no longer lists.
    async closeEnded() {
      const ended = [...sessions].filter(([, entry]) => !entry.live());
      for (const [key] of ended) sessions.delete(key);
      await Promise.all(ended.map(async ([, { what, targets }]) => {
        const results = await Promise.all([...targets].map((targetId) => close(chromePort, targetId)
          .catch((error) => { log(`could not close a tab of "${what}": ${error.message}`); return false; })));
        const closed = results.filter(Boolean).length;
        if (closed) log(`closed ${closed} tab${closed === 1 ? "" : "s"} that "${what}" left open`);
      }));
      let gone = [];
      if (kept.size) {
        try {
          const open = await list(chromePort);
          gone = [...kept.keys()].filter((targetId) => !open.has(targetId));
        } catch { /* Chrome did not answer: keep the records until it does */ }
        for (const targetId of gone) kept.delete(targetId);
      }
      // Saved after the closes, so a gate that dies during them closes the
      // tabs again after its restart (a repeat close only gets a 404).
      if (ended.length || gone.length) save();
    },
  };
}

// --- The server --------------------------------------------------------------

// PUT /agent-chrome/keep/<targetId>?what=<why>: leave a tab open after the
// session ends, for the owner. The gate is the authority on which tabs a session
// opened, so it, not the caller, decides.
const KEEP_RULE = "A session may keep only a tab it opened itself through this gate (Target.createTarget or /json/new), and only while it runs; not another session's tab, the owner's own, or one already kept.";
const KEEP_USAGE = "agent-chrome-gate: keep a tab with PUT /agent-chrome/keep/<targetId>?what=<why>.";
// Every /agent-chrome path is the gate's own and never reaches Chrome, so the
// gate never answers it with Chrome's 404: a keep that gets a 404 met a gate
// from before keep, which closes no tabs.
function answerKeep(req, res, path, client, declaration, tabs) {
  const text = (status, body, headers = {}) => res.writeHead(status, { "Content-Type": "text/plain; charset=utf-8", ...headers }).end(`${body}\n`);
  if (!declaration) return text(403, `agent-chrome-gate: refused to keep a tab for ${client}: this process is in no live session. ${KEEP_RULE}`);
  const encoded = /^\/agent-chrome\/keep\/([^/]+)$/.exec(path)?.[1];
  if (!encoded) return text(400, KEEP_USAGE);
  if (req.method !== "PUT") return text(405, KEEP_USAGE, { Allow: "PUT" });
  let targetId;
  try { targetId = decodeURIComponent(encoded); } catch { targetId = encoded; }
  const what = new URL(req.url ?? "", "http://gate").searchParams.get("what")?.trim();
  if (!what || what.length > 120) return text(400, "agent-chrome-gate: say in under 120 characters why the tab stays open (no personal data): PUT /agent-chrome/keep/<targetId>?what=<why>.");
  if (!tabs.keep(declaration, targetId, what)) return text(403, `agent-chrome-gate: refused to keep tab ${targetId} for "${declaration.what}". ${KEEP_RULE}`);
  return text(200, `kept ${targetId}: the gate leaves it open after "${declaration.what}" ends.`);
}

function deny(socket, body) {
  socket.end(`HTTP/1.1 403 Forbidden\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: ${Buffer.byteLength(body)}\r\nConnection: close\r\n\r\n${body}`);
}

// How long the gate keeps Chrome's side of a connection open, after the client
// has gone, for a Target.createTarget answer still due: the runner's own CDP
// deadline (scripts/agent-chrome-playwright CDP_TIMEOUT) and a margin.
const ANSWER_GRACE = 20000;

function createGate({ chromePort = Number(process.env.AGENT_CHROME_GATE_CHROME_PORT || CHROME_PORT), identify: find = identify, adopt = session.adopt, graceUntil = GRACE_UNTIL, now = Date.now, log = () => {}, tabsFile = null, closeTab: closer = closeTab, listTabs: lister = listTabs, answerGrace = ANSWER_GRACE } = {}) {
  const tabs = tabTracker({ chromePort, file: tabsFile, graceUntil, log, close: closer, list: lister, now });
  // One notice per undeclared process, however many connections it opens at once.
  const adopting = new Map();
  const identifyClient = (socket) => Promise.resolve().then(() => find(socket, { graceUntil })).catch(() => ({ client: "an unknown process (could not read it)" }));
  const who = async (socket) => {
    const found = await identifyClient(socket);
    if (found.declaration || !found.pid || now() >= graceUntil) return found;
    if (!adopting.has(found.pid)) {
      const adopted = Promise.resolve().then(() => adopt({ pid: found.pid, what: found.name }))
        .catch((error) => { log(`could not declare ${found.client} on its behalf: ${error.message}`); return null; });
      adopting.set(found.pid, adopted.finally(() => adopting.delete(found.pid)));
      log(`let ${found.client} through without a declaration (migration window); told the owner`);
    }
    const adopted = await adopting.get(found.pid);
    return adopted ? { ...found, declaration: reader(adopted, graceUntil) } : found;
  };
  // Open CDP WebSockets, each with its declaration, so they close when it ends.
  const connections = new Set();
  let idle = null;
  let identifying = 0;
  const checkIdle = () => {
    if (connections.size === 0 && identifying === 0 && idle) idle();
  };
  const server = http.createServer(async (req, res) => {
    identifying += 1;
    try {
      const path = (req.url ?? "").split("?")[0].replace(/\/$/, "");
      // A tab opened through /json/new is the session's too.
      let opener = null;
      // Only the live session that opened a tab may keep it, and a process
      // adopted now has opened none, so a keep identifies its caller without
      // adopting it: the owner hears nothing about a keep that is refused anyway.
      if (path === "/agent-chrome" || path.startsWith("/agent-chrome/")) {
        const { client, declaration } = await identifyClient(req.socket);
        if (!declaration) log(`refused HTTP ${path} from ${client}`);
        answerKeep(req, res, path, client, declaration, tabs);
        return;
      }
      if (!(req.method === "GET" && PROBES.has(path))) {
        const { client, declaration } = await who(req.socket);
        if (!declaration) {
          log(`refused HTTP ${path} from ${client}`);
          res.writeHead(403, { "Content-Type": "text/plain; charset=utf-8" }).end(refusal(client));
          return;
        }
        if (/^\/json\/(new|activate)\b/.test(path) && !declaration.current().foreground) {
          res.writeHead(403, { "Content-Type": "text/plain; charset=utf-8" }).end(`${REFUSALS.front}\n`);
          return;
        }
        if (/^\/json\/new\b/.test(path)) opener = declaration;
      }
      const upstream = http.request({ host: "127.0.0.1", port: chromePort, method: req.method, path: req.url, headers: req.headers }, (answer) => {
        res.writeHead(answer.statusCode ?? 502, answer.headers);
        if (opener && answer.statusCode === 200) {
          const body = [];
          answer.on("data", (chunk) => body.push(chunk));
          answer.once("end", () => {
            try { tabs.opened(opener, JSON.parse(Buffer.concat(body).toString("utf8")).id); } catch { /* not a tab */ }
          });
        }
        answer.pipe(res);
      });
      upstream.on("error", () => { if (!res.headersSent) res.writeHead(502).end("agent-chrome-gate: the agent Chrome is not answering on its DevTools port.\n"); else res.destroy(); });
      req.pipe(upstream);
    } finally {
      identifying -= 1;
      checkIdle();
    }
  });

  server.on("upgrade", async (req, client, head) => {
    identifying += 1;
    try {
      // The client may hang up while netstat and ps run; then nothing opens upstream.
      // Reading it meanwhile is what surfaces the hang-up; the bytes are kept.
      let gone = false;
      const early = [];
      const hold = (chunk) => early.push(chunk);
      client.on("data", hold);
      client.once("end", () => { gone = true; });
      client.once("close", () => { gone = true; });
      client.on("error", () => client.destroy());
      const { client: name, declaration } = await who(client);
      client.off("data", hold);
      if (gone || client.destroyed) {
        client.destroy();
        return;
      }
      if (!declaration) {
        log(`refused WebSocket from ${name}`);
        deny(client, refusal(name));
        return;
      }
      const upstream = net.connect(chromePort, "127.0.0.1");
      // CDP is many small request-reply frames; Nagle would delay each one.
      client.setNoDelay(true);
      upstream.setNoDelay(true);
      // Target.createTarget commands Chrome has not answered yet, by session
      // and id. Their answers name the tabs this session opened.
      const creating = new Set();
      let draining = null;
      // Once the client has gone, Chrome's side stays open only for those answers.
      const finish = () => {
        clearTimeout(draining);
        client.destroy();
        upstream.destroy();
        if (connections.delete(connection)) checkIdle();
      };
      const close = () => {
        client.destroy();
        if (creating.size === 0 || upstream.destroyed) finish();
        else draining ??= setTimeout(finish, answerGrace);
      };
      const connection = { declaration, close, closing: false };
      connections.add(connection);
      upstream.on("error", finish);
      client.on("close", close);
      // A hang-up on either side ends the other, after what is already in flight.
      client.on("end", () => (creating.size ? close() : upstream.end()));
      upstream.on("end", () => client.end());
      upstream.on("close", () => (client.destroyed ? finish() : client.end(finish)));
      const toClient = new FrameStream((bytes) => { if (!client.destroyed) client.write(bytes); }, (text) => {
        let answer;
        try { answer = JSON.parse(text); } catch { return null; }
        const key = `${answer?.sessionId ?? ""} ${answer?.id}`;
        if (!creating.delete(key)) return null;
        tabs.opened(declaration, answer.result?.targetId);
        if (client.destroyed && creating.size === 0) finish();
        return null;
      }, () => creating.size > 0);
      const toChrome = new FrameStream((bytes) => upstream.write(bytes), (text, mask) => {
        if (!declaration.live()) {
          log(`closed a connection from ${name}: its session "${declaration.what}" has ended`);
          close();
          return Buffer.alloc(0);
        }
        const replacement = filterCommand(text, mask, declaration, (bytes) => toClient.inject(bytes), log);
        if (replacement?.length !== 0 && text.includes("Target.createTarget")) {
          try {
            const command = JSON.parse(text);
            if (command.method === "Target.createTarget") creating.add(`${command.sessionId ?? ""} ${command.id}`);
          } catch { /* filterCommand passed it through unread */ }
        }
        return replacement;
      });
      // Chrome's 101 response comes before its frames.
      let opening = Buffer.alloc(0);
      upstream.on("data", (chunk) => {
        if (!opening) return toClient.push(chunk);
        opening = Buffer.concat([opening, chunk]);
        const end = opening.indexOf("\r\n\r\n");
        if (end < 0) return undefined;
        client.write(opening.subarray(0, end + 4));
        const rest = opening.subarray(end + 4);
        opening = null;
        if (rest.length) toClient.push(rest);
        return undefined;
      });
      // No compression: the gate reads commands as plain text frames.
      const lines = [`${req.method} ${req.url} HTTP/1.1`];
      for (let i = 0; i < req.rawHeaders.length; i += 2) {
        if (req.rawHeaders[i].toLowerCase() !== "sec-websocket-extensions") lines.push(`${req.rawHeaders[i]}: ${req.rawHeaders[i + 1]}`);
      }
      upstream.write(`${lines.join("\r\n")}\r\n\r\n`);
      for (const chunk of [head, ...early]) if (chunk.length) toChrome.push(chunk);
      client.on("data", (chunk) => toChrome.push(chunk));
    } finally {
      identifying -= 1;
      checkIdle();
    }
  });

  // Close connections whose session ended while they sat idle. The gate runs
  // this with each sweep; a command on an ended session closes it at once.
  // It also closes the tabs of sessions that have ended, and returns that work.
  server.closeEnded = () => {
    for (const connection of connections) {
      if (connection.closing || connection.declaration.live()) continue;
      connection.closing = true;
      log(`closed a connection: its session "${connection.declaration.what}" has ended`);
      connection.close();
    }
    checkIdle();
    return tabs.closeEnded();
  };
  // Wait for CDP sockets and identification/adoption work already in flight.
  server.whenIdle = (callback) => {
    idle = () => { idle = null; callback(); };
    checkIdle();
  };
  return server;
}

// The launchd agent runs this file from the live ~/dotfiles checkout, which the
// hourly sync fast-forwards. When the gate or the helper it reads changes, the
// gate exits once no CDP connection is open, and launchd (KeepAlive) starts
// the new code. Calls back on the first change.
function onCodeChange(files, callback, interval = 60000) {
  let fired = false;
  const listener = (now, before) => {
    if (fired || now.mtimeMs === before.mtimeMs) return;
    fired = true;
    for (const file of files) fs.unwatchFile(file, listener);
    callback();
  };
  for (const file of files) fs.watchFile(file, { interval, persistent: false }, listener);
}

module.exports = { LISTEN_PORT, CHROME_PORT, GRACE_UNTIL, ANSWER_GRACE, policy, frameHeader, encodeFrame, unmask, FrameStream, filterCommand, clientPid, chain, match, reader, identify, closeTab, listTabs, tabTracker, createGate, onCodeChange, refusal, REFUSALS };
if (require.main === module) {
  const port = Number(process.env.AGENT_CHROME_GATE_PORT || LISTEN_PORT);
  const chromePort = Number(process.env.AGENT_CHROME_GATE_CHROME_PORT || CHROME_PORT);
  const log = (message) => process.stderr.write(`${new Date().toISOString()} agent-chrome-gate: ${message}\n`);
  // Test hook only: tests/agent_chrome_replay_test.cjs runs a gate past the window.
  const graceUntil = Number(process.env.AGENT_CHROME_GATE_TEST_GRACE_UNTIL || GRACE_UNTIL);
  const tabsFile = session.tabsFile();
  const server = createGate({ chromePort, graceUntil, log, tabsFile });
  server.on("error", (error) => { log(error.message); process.exit(1); });
  server.listen(port, "127.0.0.1", () => log(`listening on 127.0.0.1:${port}, Chrome on ${chromePort}`));
  const sweep = () => session.sweep(undefined, graceUntil).catch((error) => log(`sweep failed: ${error.message}`)).then(() => server.closeEnded());
  // Test hook only: the replay test sweeps faster than the five seconds here.
  setInterval(sweep, Number(process.env.AGENT_CHROME_GATE_TEST_SWEEP_MS || 5000));
  onCodeChange([__filename, require.resolve("./agent-chrome-session")], () => {
    log("its code changed; restarting once no connection is open");
    server.whenIdle(() => {
      server.close(() => process.exit(0));
      setTimeout(() => process.exit(0), 5000);
    });
  }, Number(process.env.AGENT_CHROME_GATE_TEST_WATCH_MS || 60000));
}
