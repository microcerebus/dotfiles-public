#!/usr/bin/env node
// Run a written, screen-free flow in its own background agent Chrome tab.
// The run is an agent-chrome-session: the owner is notified before it and when it
// ends, and scripts/agent-chrome-gate lets only declared sessions through.
// When the run ends, the runner closes its tab and the gate closes every other
// tab the run opened. A tab the flow leaves for the owner on purpose (a form for
// him to review, a sign-in he finishes) is kept with the flow's second
// argument: module.exports = async (page, { keep }) => { ...; await keep(tab, "why"); }.
const { spawnSync } = require("node:child_process");
const { createHash, randomBytes, randomUUID } = require("node:crypto");
const http = require("node:http");
const { homedir } = require("node:os");
const { basename, join, resolve } = require("node:path");
const { setTimeout: sleep } = require("node:timers/promises");
const { agentChromeFlagsError } = require("./chrome-devtools-axi");
const { frameHeader, encodeFrame } = require("./agent-chrome-gate");
const { withSession, current, keepTab, SIGNALS, GATE_URL } = require("./agent-chrome-session");

// pnpm prints warnings on stdout too: pnpm 12 warns about --global inside a
// project that pins packageManager, which broke job-tracker's runs on
// 2026-10-22. So pnpm runs from the home directory, and the listing is the
// first line starting with "[" from which a JSON array parses, up to the last
// line that keeps it whole. Notices around it may end in "]" or be arrays too.
function globalListing(stdout) {
  const lines = stdout.split(/\r?\n/);
  for (let start = 0; start < lines.length; start += 1) {
    if (!lines[start].startsWith("[")) continue;
    for (let end = lines.length; end > start; end -= 1) {
      try {
        const listing = JSON.parse(lines.slice(start, end).join("\n"));
        if (Array.isArray(listing)) return listing;
      } catch { /* a warning such as "[WARN] ...", or a notice after the listing */ }
    }
  }
  throw new Error("pnpm ls -g printed no JSON listing.");
}

function playwrightDirectory() {
  const listed = spawnSync("pnpm", ["ls", "-g", "--depth", "0", "--json"], { encoding: "utf8", cwd: homedir() });
  if (listed.status !== 0) throw new Error("Cannot locate pinned playwright-core through pnpm.");
  const directory = globalListing(listed.stdout).map((entry) => entry.dependencies?.["playwright-core"]?.path).find(Boolean);
  if (!directory) throw new Error("playwright-core is missing; see scripts/dotfiles-autoupdate.");
  return directory;
}

const playwright = () => require(playwrightDirectory());

// A wedged Chrome or gate must not hold the run: each step gets this long.
const CDP_TIMEOUT = 15000;

function within(promise, what, timeout, onTimeout = () => {}) {
  let timer;
  const late = new Promise((_, failed) => {
    timer = setTimeout(() => {
      failed(new Error(`${what}: the agent Chrome did not answer within ${timeout / 1000}s.`));
      onTimeout();
    }, timeout);
  });
  return Promise.race([promise, late]).finally(() => clearTimeout(timer));
}

// A CDP WebSocket on a TCP socket the runner owns. Node's WebSocket cannot be
// let go of: after a timeout, close() waits for the peer's closing handshake,
// and a peer that never sends it kept the process alive for good. The frame
// codec is the gate's.
function cdpSocket(webSocketUrl, url, timeout) {
  const { hostname, port, pathname, search } = new URL(webSocketUrl);
  const key = randomBytes(16).toString("base64");
  const accept = createHash("sha1").update(`${key}258EAFA5-E914-47DA-95CA-C5AB0DC85B11`).digest("base64");
  let request;
  let socket;
  return within(new Promise((opened, failed) => {
    request = http.get({ hostname, port, path: pathname + search, headers: {
      Connection: "Upgrade",
      Upgrade: "websocket",
      "Sec-WebSocket-Version": "13",
      "Sec-WebSocket-Key": key,
    } });
    request.once("upgrade", (response, upgraded, head) => {
      socket = upgraded;
      if (response.headers["sec-websocket-accept"] === accept) return opened({ socket, head });
      socket.destroy();
      failed(new Error(`The agent Chrome did not complete the WebSocket handshake on ${url}.`));
    });
    // The gate refuses an undeclared process with a 403 that says why.
    request.once("response", (response) => {
      let body = "";
      response.setEncoding("utf8").on("data", (chunk) => { body += chunk; }).once("end", () => {
        failed(new Error(`The agent Chrome answered ${response.statusCode} to a CDP connection on ${url}.${body.trim() ? `\n${body.trim()}` : ""}`));
      });
    });
    request.once("error", (error) => failed(new Error(`Cannot open a CDP connection to the agent Chrome on ${url}: ${error.message}`)));
  }), "Opening a CDP connection", timeout, () => {
    request.destroy();
    socket?.destroy();
  });
}

// An empty close frame, masked as every client frame must be.
const CLOSE_FRAME = Buffer.from([0x88, 0x80, 0, 0, 0, 0]);

// Opens the flow's background tab on a CDP connection of its own, before
// Playwright attaches. When the agent Chrome's last window closes, Chrome
// unloads its profile, and Playwright's connectOverCDP then fails at
// Browser.setDownloadBehavior with "Browser context management is not
// supported." (job-tracker, 2026-10-22). Target.createTarget loads the profile
// again. With no window left, Chrome opens one for the tab and, as the tab is
// a background one, orders it behind every other window instead of in front.
// `timeout` is ms for every step, or ms per step name with a `default`, so a
// test can stall one step without racing the others against a short deadline.
async function openBackgroundTab(marker, url = GATE_URL, timeout = CDP_TIMEOUT) {
  const deadline = (what) => (typeof timeout === "number" ? timeout : timeout[what] ?? timeout.default ?? CDP_TIMEOUT);
  const reading = new AbortController();
  const version = await within(fetch(`${url}/json/version`, { signal: reading.signal })
    .then(async (response) => ({ status: response.status, ok: response.ok, body: await response.text() })),
  "Reading /json/version", deadline("Reading /json/version"), () => reading.abort());
  if (!version.ok) throw new Error(`The agent Chrome answered ${version.status} on ${url}/json/version.${version.body.trim() ? `\n${version.body.trim()}` : ""}`);
  const { socket, head } = await cdpSocket(JSON.parse(version.body).webSocketDebuggerUrl, url, deadline("Opening a CDP connection"));
  const pending = new Map();
  let lastId = 0;
  let closed = false;
  // Why the connection went, for the commands it leaves unanswered.
  let gone = "closed the connection";
  let buffered = Buffer.alloc(0);
  // The fragments of the text message being read; null between messages and
  // while a binary one is read.
  let text = null;
  const answer = (message) => {
    const reply = JSON.parse(message);
    if (typeof reply !== "object" || reply === null) throw new Error("not a CDP message");
    const waiting = pending.get(reply.id);
    if (!waiting) return;
    pending.delete(reply.id);
    if (reply.error) waiting.failed(new Error(`${waiting.method}: ${reply.error.message}`));
    else waiting.answered(reply.result);
  };
  const read = (chunk) => {
    buffered = Buffer.concat([buffered, chunk]);
    try {
      for (let header = frameHeader(buffered); header && buffered.length >= header.size + header.length; header = frameHeader(buffered)) {
        // A server never masks its frames.
        if (header.mask) throw new Error("a masked frame");
        const payload = buffered.subarray(header.size, header.size + header.length);
        buffered = buffered.subarray(header.size + header.length);
        if (header.opcode === 8) return socket.destroy();
        // Chrome sends text messages and never pings.
        if (header.opcode === 1 || header.opcode === 2) text = header.opcode === 1 ? [] : null;
        else if (header.opcode !== 0) continue;
        if (!text) continue;
        text.push(payload);
        if (!header.fin) continue;
        const message = Buffer.concat(text).toString("utf8");
        text = null;
        answer(message);
      }
    } catch {
      // A peer that breaks the protocol fails what is pending, through the
      // close below, instead of throwing out of this handler and the process.
      gone = "sent a malformed CDP message";
      socket.destroy();
    }
  };
  socket.on("data", read);
  socket.on("error", () => {});
  socket.once("close", () => {
    closed = true;
    for (const { method, failed } of pending.values()) failed(new Error(`${method}: the agent Chrome ${gone}.`));
    pending.clear();
  });
  if (head.length) read(head);
  const send = (method, params) => {
    if (closed) return Promise.reject(new Error(`${method}: the agent Chrome ${gone}.`));
    lastId += 1;
    const id = lastId;
    return within(new Promise((answered, failed) => {
      pending.set(id, { method, answered, failed });
      socket.write(encodeFrame(JSON.stringify({ id, method, params }), randomBytes(4)));
    }), method, deadline(method), () => pending.delete(id));
  };
  // A close frame, then the socket goes, whether or not the peer answers it.
  const hangUp = () => {
    if (closed) return;
    socket.end(CLOSE_FRAME, () => socket.destroy());
    setTimeout(() => socket.destroy(), 1000).unref();
  };
  try {
    const { targetId } = await send("Target.createTarget", { url: marker, background: true });
    return {
      targetId,
      // A tab the flow kept stays open; the runner only hangs up.
      release: async () => hangUp(),
      // A flow may close its own tab with page.close(); then the tab is
      // already gone, which is what closing it was for.
      close: async () => {
        try { await send("Target.closeTarget", { targetId }); }
        catch (error) { if (!/: No target with given id found$/.test(error.message)) throw error; }
        finally { hangUp(); }
      },
    };
  } catch (error) {
    // A createTarget that answers after its deadline still opens the tab, so
    // the runner looks for it by its marker. That is two more deadlines, so a
    // peer that stalls can take about 45s (three 15s deadlines) to fail the run.
    try {
      const { targetInfos } = await send("Target.getTargets");
      await Promise.all(targetInfos.filter((info) => info.url === marker).map(({ targetId }) => send("Target.closeTarget", { targetId })));
    } catch { /* the original error says what went wrong */ }
    hangUp();
    throw error;
  }
}

// A Playwright page's CDP target id, which the gate knows the tab by.
async function targetIdOf(page) {
  const cdp = await page.context().newCDPSession(page);
  try { return (await cdp.send("Target.getTargetInfo")).targetInfo.targetId; }
  finally { await cdp.detach().catch(() => {}); }
}

const defaults = {
  ready: () => spawnSync(join(__dirname, "agent-chrome-ready"), [], { stdio: "inherit" }).status === 0,
  identityError: () => agentChromeFlagsError(),
  openTab: (marker) => openBackgroundTab(marker),
  connect: () => playwright().chromium.connectOverCDP(GATE_URL),
  targetId: targetIdOf,
  keepTab: (targetId, why) => keepTab(targetId, why, GATE_URL),
  sleep,
  log: (message) => process.stderr.write(`agent-chrome-playwright: ${message}\n`),
  // Aborting closes the flow's tab, so a stopped run leaves nothing behind.
  signal: null,
  keepPopups: false,
  // How long a second signal waits for the flow's tab; tests record it.
  patience: sleep,
};

// A link with target=_blank or a window.open from the flow opens a tab Chrome
// brings to the front of the owner's screen, so the runner closes it at once.
const POPUP = "closed a popup the flow opened (it comes to the front of the owner's screen). Open the URL in the flow's own tab with page.goto, or pass --keep-popups if the flow needs it.";

async function run(flow, deps = defaults) {
  const checkStopped = () => {
    if (deps.signal?.aborted) throw new DOMException("Stopped before the flow started.", "AbortError");
  };
  checkStopped();
  let ready;
  try { ready = deps.ready(); }
  finally {
    // spawnSync readiness can delay a signal handler until the next turn.
    await new Promise((resolve) => setImmediate(resolve));
    checkStopped();
  }
  if (!ready) throw new Error("agent-chrome-ready failed; no browser flow started.");
  const identityError = deps.identityError();
  if (identityError) throw new Error(identityError);
  const marker = `about:blank#screen-free-${randomUUID()}`;
  // A stop can come while the tab is still opening, so closing waits for it.
  // However many signals ask, the tab is closed once.
  const opening = deps.openTab(marker);
  // Tabs the flow kept for the owner, by target id; the gate leaves them open.
  const kept = new Set();
  const keep = async (tab, why) => {
    const targetId = await deps.targetId(tab);
    await deps.keepTab(targetId, why);
    kept.add(targetId);
  };
  let closing;
  const closeOwnTab = () => (closing ??= opening.then((tab) => (kept.has(tab.targetId) ? tab.release() : tab.close())));
  deps.onCloseTab?.(closeOwnTab);
  await opening;
  let browser;
  let context;
  let newPage;
  try {
    checkStopped();
    browser = await deps.connect();
    context = browser.contexts()[0];
    if (!context) throw new Error("The agent Chrome has no browser context.");
    let page;
    for (let attempt = 0; attempt < 100; attempt += 1) {
      page = context.pages().find((candidate) => candidate.url() === marker);
      if (page) break;
      await deps.sleep(50);
    }
    if (!page) throw new Error("Playwright did not attach to its background tab.");
    if (!deps.keepPopups) {
      const watchPopups = (owned) => owned.on("popup", (popup) => {
        deps.log(POPUP);
        popup.close().catch(() => {});
      });
      watchPopups(page);
      newPage = context.newPage;
      context.newPage = async (...args) => {
        const owned = await newPage.apply(context, args);
        watchPopups(owned);
        return owned;
      };
    }
    if (deps.signal?.aborted) throw new Error("Stopped before the flow started.");
    deps.signal?.addEventListener("abort", () => { closeOwnTab().catch(() => {}); }, { once: true });
    return await flow(page, { keep });
  } finally {
    if (newPage) context.newPage = newPage;
    try {
      await closeOwnTab();
    } finally {
      // connectOverCDP browsers disconnect here; they do not quit Chrome.
      await browser?.close();
    }
  }
}

const USAGE = 'Usage: agent-chrome-playwright [--minutes N] [--what "what it does"] [--keep-popups] <flow.cjs>\n'
  + "the owner gets a notification (what, about how long) before the flow starts and when it ends.\n"
  + "Popups the flow opens are closed unless --keep-popups is passed.\n"
  + "The file must export async function(page, { keep }); never bring tabs to the front or close the browser.\n"
  + "When the run ends its tabs close; await keep(tab, \"why\") leaves one open for the owner.\n";
// What a stop that waits for the agent Chrome prints after a second, so one
// Ctrl-C against a slow or wedged Chrome does not look hung.
const STOPPING = "stopping: closing the flow's tab once the agent Chrome answers (it has 15s per step). Ctrl-C again stops now, and the gate closes the tab when the run ends.";
// Calls written before the notifications passed only the flow file; they keep
// working, with the file name and five minutes in the notice.
const DEFAULT_MINUTES = 5;

function parseArgs(args) {
  const spec = {};
  const files = [];
  for (let i = 0; i < args.length; i += 1) {
    if (args[i] === "--minutes") spec.minutes = /^\d+$/.test(args[i + 1] ?? "") ? Number(args[++i]) : NaN;
    else if (args[i] === "--what") spec.what = args[++i];
    else if (args[i] === "--keep-popups") spec.keepPopups = true;
    else files.push(args[i]);
  }
  if (files.length !== 1) throw new Error(USAGE);
  const missing = ["--minutes", "--what"].filter((flag) => spec[flag.slice(2)] === undefined);
  return {
    minutes: spec.minutes ?? DEFAULT_MINUTES,
    what: spec.what ?? `Playwright flow ${basename(files[0])}`,
    file: files[0],
    keepPopups: Boolean(spec.keepPopups),
    missing,
  };
}

// The command line. Tests pass their own run and session deps.
function cli(args, deps = defaults, sessionDeps = undefined) {
  let stopped = null;
  let first = null;
  let waiting;
  let closeTab = async () => {};
  return Promise.resolve().then(() => {
    const { file, missing, keepPopups, ...spec } = parseArgs(args);
    if (missing.length) process.stderr.write(`agent-chrome-playwright: pass ${missing.join(" and ")} so the owner's notice says what the flow does and how long it takes.\n`);
    const flow = require(resolve(file));
    if (typeof flow !== "function") throw new Error("The flow must export a function that receives its own page.");
    // The first signal closes the flow's tab, which ends the flow. A second
    // exits once the tab is closed, or after 3s. Under agent-chrome-session
    // run from a terminal, one Ctrl-C arrives twice, from the terminal and
    // forwarded by the session, so there the runner waits up to the CDP
    // deadline for a tab still being created. A real second Ctrl-C ends the
    // runner: agent-chrome-session SIGKILLs it, and from a terminal, nested,
    // it SIGKILLs the inner session and the gate cuts the runner off once the
    // outer one has ended. Run directly, a second Ctrl-C while createTarget
    // takes over 3s exits before the tab opens. Either way the gate closes
    // that tab when the session ends.
    const patience = current() ? CDP_TIMEOUT : 3000;
    const stopping = new AbortController();
    const onSignal = (signal, count, stop) => {
      if (count === 1) {
        first = signal;
        stopping.abort();
        waiting = setTimeout(() => process.stderr.write(`agent-chrome-playwright: ${STOPPING}\n`), 1000);
        waiting.unref();
      } else stopped ??= Promise.race([closeTab().catch(() => {}), (deps.patience ?? defaults.patience)(patience)]).then(() => stop(signal));
    };
    return withSession({ ...spec, onSignal },
      () => run(flow, { ...deps, signal: stopping.signal, keepPopups, onCloseTab: (close) => { closeTab = close; } }), sessionDeps);
  }).catch((error) => {
    process.stderr.write(`agent-chrome-playwright: ${error.message}${error.message.endsWith("\n") ? "" : "\n"}`);
    // A stopped flow exits as if the signal had killed it, so a wrapping
    // session reports it stopped rather than failed.
    process.exitCode = first ? 128 + SIGNALS[first] : 1;
  }).finally(() => {
    clearTimeout(waiting);
    // Once the session has ended, the run is over: a socket or timer the flow
    // or a wedged peer left open must not keep it alive. What it printed is
    // flushed first; pipes on macOS are written asynchronously. After a second
    // signal this never runs: the session's stop waits on the same ending as
    // withSession and exits first, with 128 + the signal, once its stopped
    // notice is out and the declaration is gone.
    process.stdout.write("", () => process.stderr.write("", () => process.exit()));
  });
}

module.exports = { run, cli, defaults, parseArgs, playwrightDirectory, openBackgroundTab, targetIdOf };
if (require.main === module) cli(process.argv.slice(2));
