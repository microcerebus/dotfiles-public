#!/usr/bin/env node
// Agents drive the agent Chrome: Google Chrome Beta with its own signed-in
// profile on 127.0.0.1:9333 (launchd agent in nix/user.nix). Attaching to
// the owner's own Chrome (autoConnect, or its chrome://inspect port 9222) makes him
// click "Allow" for every session, so it needs a named opt-in.
// The agent Chrome must run with no extensions and no Chrome sync (launchd
// flags in nix/user.nix): a Google sign-in there once synced the owner's own
// extensions in, Dashlane included. An agent Chrome started any other way,
// such as from an old plist after a reboot, is refused, not driven.
// Every agent shares the agent Chrome's one window, and it sits where the owner's
// own Chrome and T3 Code do. A tab opened in the foreground raises that
// window over his work and takes the keyboard. `resize` reshapes it for every
// agent's tabs at once and stops at macOS's 500px floor, so "390" phone shots
// came out 500 wide. On 2026-10-11 he saw Lavish pages there boxed into other
// agents' 390x844 and 1440x900 viewports. So agent tabs open in the
// background, sizes come from per-tab `emulate --viewport`, and --foreground
// is the opt-in for a page the owner has to see or click.
// Tests: tests/chrome_devtools_axi_test.cjs.
const { spawnSync } = require("node:child_process");
const { randomBytes } = require("node:crypto");
const { existsSync } = require("node:fs");
const { homedir } = require("node:os");
const { join } = require("node:path");

const AXI_BINARY = join(homedir(), "Library/pnpm/bin/chrome-devtools-axi");
const FOREGROUND = "--foreground";
const AGENT_CHROME_URL = "http://127.0.0.1:9333";
const AGENT_CHROME_LABEL = "com.myuser.agent-chrome";
const AGENT_CHROME_BINARY = "/Applications/Google Chrome Beta.app/Contents/MacOS/Google Chrome Beta";
const AGENT_CHROME_FLAGS = ["--disable-extensions", "--disable-sync"];
const MAIN_CHROME_PORT = "9222";
const NO_BROWSER = new Set(["stop", "setup", "update", "--help", "-v", "-V", "--version"]);

const MAIN_CHROME_REFUSAL = `chrome-devtools-axi: refusing to attach to the owner's own Chrome, which asks him to click "Allow" for every session.
Unset CHROME_DEVTOOLS_AXI_AUTO_CONNECT and any :${MAIN_CHROME_PORT} CHROME_DEVTOOLS_AXI_BROWSER_URL; axi then drives the agent Chrome on ${AGENT_CHROME_URL}, which is signed in to the sites agents need.
Only if the owner asked for his own Chrome in this thread, set CHROME_DEVTOOLS_AXI_MAIN_CHROME=1.
`;

function targetsPort(url, port) {
  try { return new URL(url).port === port; } catch { return false; }
}

function resolveEnv(env) {
  const out = { ...env };
  // One bridge and one selected tab per Claude thread instead of one shared
  // default session, and bridges that exit after 30 idle minutes instead of
  // piling up for days.
  if (env.CHROME_DEVTOOLS_AXI_SESSION === undefined && env.CLAUDE_CODE_SESSION_ID) {
    out.CHROME_DEVTOOLS_AXI_SESSION = `claude-${env.CLAUDE_CODE_SESSION_ID.slice(0, 8)}`;
  }
  out.CHROME_DEVTOOLS_AXI_IDLE_TIMEOUT_MS ??= String(30 * 60 * 1000);
  if (env.CHROME_DEVTOOLS_AXI_MAIN_CHROME === "1") {
    delete out.CHROME_DEVTOOLS_AXI_BROWSER_URL;
    out.CHROME_DEVTOOLS_AXI_AUTO_CONNECT = "1";
    return { env: out, target: "main" };
  }
  if (env.CHROME_DEVTOOLS_AXI_AUTO_CONNECT === "1" || targetsPort(env.CHROME_DEVTOOLS_AXI_BROWSER_URL ?? "", MAIN_CHROME_PORT)) {
    return { error: MAIN_CHROME_REFUSAL };
  }
  delete out.CHROME_DEVTOOLS_AXI_AUTO_CONNECT;
  const url = env.CHROME_DEVTOOLS_AXI_BROWSER_URL;
  // An explicit other URL, "" (axi launches a throwaway browser) or an own
  // profile dir is a deliberate choice and passes through.
  if ((url === undefined && env.CHROME_DEVTOOLS_AXI_USER_DATA_DIR === undefined)
    || targetsPort(url ?? "", new URL(AGENT_CHROME_URL).port)) {
    out.CHROME_DEVTOOLS_AXI_BROWSER_URL = AGENT_CHROME_URL;
    return { env: out, target: "agent" };
  }
  return { env: out, target: "other" };
}

function ensureAgentChrome(env, deps, io) {
  if (deps.probe(AGENT_CHROME_URL)) return env;
  if (!deps.agentInstalled()) {
    io.stderr.write("chrome-devtools-axi: the agent Chrome is not set up yet (it arrives with the next `rebuild`), so this session uses a throwaway headless Chrome without sign-ins.\n");
    const out = { ...env };
    delete out.CHROME_DEVTOOLS_AXI_BROWSER_URL;
    return out;
  }
  deps.kickstart();
  for (let i = 0; i < 30; i += 1) {
    if (deps.probe(AGENT_CHROME_URL)) return env;
    deps.sleep(500);
  }
  io.stderr.write(`chrome-devtools-axi: the agent Chrome did not come up on ${AGENT_CHROME_URL} within 15s. See ~/Library/Logs/agent-chrome.log, or restart it with \`launchctl kickstart -k gui/$(id -u)/${AGENT_CHROME_LABEL}\`.\n`);
  return null;
}

function agentChromeFlagsError(deps) {
  const lines = deps.browserCommandLines();
  const unsafe = lines.length === 0
    || lines.some((line) => AGENT_CHROME_FLAGS.some((flag) => !line.split(" ").includes(flag)));
  if (!unsafe) return null;
  return `chrome-devtools-axi: the agent Chrome on ${AGENT_CHROME_URL} is not running with ${AGENT_CHROME_FLAGS.join(" ")}, so the owner's synced extensions (Dashlane included) can load into agent sessions. Not driving it.
It was started from an old launchd plist (no \`rebuild\` since the flags landed) or by hand. If \`rebuild\` has run, restart it: \`launchctl kickstart -k gui/$(id -u)/${AGENT_CHROME_LABEL}\`. Otherwise ask the owner to run \`rebuild\`.
`;
}

function resizeRefusal(args) {
  const [width, height] = args.slice(1, 3).map((arg) => Number.parseInt(arg, 10));
  const size = width > 0 && height > 0 ? `${width}x${height}` : "390x844";
  return `chrome-devtools-axi: refusing \`resize\`. It reshapes the agent Chrome's one window, which every agent's tabs and the owner's view share, and macOS stops it at 500px wide.
Size only your own tab: \`chrome-devtools-axi emulate --viewport "${size}x3,mobile,touch"\` for a phone, or --viewport "${size}x1" for a desktop.
When you are done, run \`chrome-devtools-axi emulate\` with no flags to clear it. the owner sees a tab left emulated as a cut-off page.
`;
}

// axi's `open` (and `page.open` in `run`) navigates the session's own tab, and
// with none it opens a new foreground tab. Give the session a background tab
// first. axi marks a session's own tab `selected` in `pages`, and adopts a
// new tab when exactly one tab has its URL, hence the unique blank URL.
function ensureOwnTab(env, spawn) {
  const pages = spawn(AXI_BINARY, ["pages"], { env, encoding: "utf8" }).stdout ?? "";
  if (/^\s*\d+,.*,true\s*$/m.test(pages)) return;
  const blank = `about:blank#${env.CHROME_DEVTOOLS_AXI_SESSION ?? "agent"}-${randomBytes(4).toString("hex")}`;
  spawn(AXI_BINARY, ["newpage", blank, "--background"], { env, stdio: "ignore" });
}

function placeTabs(args, env, spawn) {
  const [command, ...rest] = args;
  if (command === "newpage" || command === "open") {
    const flags = rest.filter((arg) => arg !== FOREGROUND);
    if (flags.length < rest.length) return ["newpage", ...flags];
    if (command === "newpage") return flags.includes("--background") ? args : [...args, "--background"];
  }
  if (command === "open" || command === "run") ensureOwnTab(env, spawn);
  return args;
}

const defaultDeps = {
  spawn: spawnSync,
  probe: (url) => spawnSync("/usr/bin/curl", ["-fsS", "-o", "/dev/null", "--max-time", "1", `${url}/json/version`],
    { stdio: "ignore" }).status === 0,
  agentInstalled: () => existsSync(join(homedir(), "Library/LaunchAgents", `${AGENT_CHROME_LABEL}.plist`)),
  kickstart: () => spawnSync("/bin/launchctl", ["kickstart", `gui/${process.getuid()}/${AGENT_CHROME_LABEL}`], { stdio: "ignore" }),
  sleep: (ms) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms),
  // Browser processes of the agent Chrome (helpers carry --type=).
  browserCommandLines: () => {
    const port = new URL(AGENT_CHROME_URL).port;
    const out = spawnSync("/usr/bin/pgrep", ["-lf", `remote-debugging-port=${port}`], { encoding: "utf8" }).stdout ?? "";
    return out.split("\n").map((line) => line.replace(/^\d+ /, ""))
      .filter((line) => line.startsWith(`${AGENT_CHROME_BINARY} `) && !line.includes("--type="));
  },
};

function run(args, env, deps = defaultDeps, io = process) {
  const resolved = resolveEnv(env);
  if (resolved.error) {
    io.stderr.write(resolved.error);
    return 2;
  }
  let childEnv = resolved.env;
  const needsBrowser = args.length > 0 && !NO_BROWSER.has(args[0]) && !args.includes("--help");
  // The agent Chrome and the owner's own are shared, headed windows; an explicit
  // other browser is the caller's own.
  const shared = resolved.target !== "other" && needsBrowser;
  if (shared && args[0] === "resize") {
    io.stderr.write(resizeRefusal(args));
    return 2;
  }
  if (resolved.target === "agent" && needsBrowser) {
    childEnv = ensureAgentChrome(childEnv, deps, io);
    if (!childEnv) return 1;
    const flagsError = childEnv.CHROME_DEVTOOLS_AXI_BROWSER_URL === AGENT_CHROME_URL && agentChromeFlagsError(deps);
    if (flagsError) {
      io.stderr.write(flagsError);
      return 1;
    }
  }
  const finalArgs = shared ? placeTabs(args, childEnv, deps.spawn) : args;
  const result = deps.spawn(AXI_BINARY, finalArgs, { env: childEnv, stdio: "inherit" });
  if (result.error) io.stderr.write(`chrome-devtools-axi: ${result.error.message}\n`);
  return result.status ?? 1;
}

module.exports = { run, resolveEnv, AGENT_CHROME_URL, AGENT_CHROME_LABEL, AGENT_CHROME_FLAGS };
if (require.main === module) process.exitCode = run(process.argv.slice(2), process.env);
