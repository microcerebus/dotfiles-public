# Neovim mappings that aren't worth quizzing (noise, duplicates, mouse).
NVIM_SKIP = re.compile(r"<Plug>|Mouse|ScrollWheel|<SNR>|which-key|Nvim builtin", re.I)
NVIM_MAX = 60  # cap so telescope/gitsigns internals don't drown the signal


def _clean_desc(desc: str) -> str:
    # strip nerd-font glyphs / private-use icons the config puts in descs
    return re.sub(r"[-\U000F0000-\U000FFFFD]", "", desc).strip()


def dump_nvim_maps():
    """Ask the live Neovim for its normal-mode maps with descriptions."""
    # headless print() has no real newlines between calls — use an explicit
    # record separator and split on it here.
    lua = (
        "local t={} for _,m in ipairs(vim.api.nvim_get_keymap('n')) do "
        "if m.desc and m.desc ~= '' then t[#t+1]=m.lhs..'\\t'..m.desc end end "
        "print(table.concat(t,'@@@'))"
    )
    try:
        out = subprocess.run(
            ["nvim", "--headless", f"+lua vim.defer_fn(function() {lua} vim.cmd('qa!') end, 4000)"],
            capture_output=True, text=True, timeout=120,
        ).stderr  # nvim prints lua output to stderr in headless mode
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return []
    pairs = []
    for rec in out.split("@@@"):
        if "\t" not in rec:
            continue
        lhs, desc = rec.split("\t", 1)
        desc = _clean_desc(desc)
        # drop vim's :-command defaults and raw API descs — noise, not training
        if desc.startswith(":") or desc.startswith("vim.lsp") or desc.startswith("vim."):
            continue
        n_leader = len(lhs) - len(lhs.lstrip(" "))   # leader (Space) in raw form
        lhs = "Space " * n_leader + lhs.lstrip(" ")
        lhs = lhs.strip()
        if not lhs or not desc or NVIM_SKIP.search(lhs + " " + desc):
            continue
        if len(lhs) > 16 or len(desc) < 4:
            continue
        pairs.append((lhs, desc))
    # stable de-dupe by lhs, keep first
    seen, uniq = set(), []
    for lhs, desc in pairs:
        if lhs not in seen:
            seen.add(lhs)
            uniq.append((lhs, desc))
    return uniq[:NVIM_MAX]


def parse_tmux_conf():
    pairs = list(TMUX_BUILTINS)
    if not TMUX_CONF.exists():
        return pairs
    for line in TMUX_CONF.read_text().splitlines():
        m = re.match(r"\s*bind(?:\s+-r)?(?:\s+-T\s+copy-mode-vi)?\s+(\S+)\s+(.+?)(?:\s*#.*)?$", line)
        if not m:
            continue
        key, cmd = m.group(1), m.group(2).strip()
        copy_mode = "-T copy-mode-vi" in line
        desc = TMUX_CMD_DESC.get(cmd)
        if not desc:
            for frag, d in TMUX_CMD_PREFIX_DESC.items():
                if cmd.startswith(frag) or frag in cmd:
                    desc = d
                    break
        if not desc:
            continue
        shown = f"{key} (copy-mode)" if copy_mode else f"C-a {key}"
        pairs.append((shown, desc))
    return pairs


def qid(topic, key):
    return hashlib.sha1(f"{topic}:{key}".encode()).hexdigest()[:12]


def build_bank():
    bank = {}
    sources = {
        "ghostty": GHOSTTY_BANK,
        "tmux": parse_tmux_conf(),
        "neovim": NVCHAD_BANK + dump_nvim_maps(),
        "motions": MOTIONS_BANK,
        "shell": SHELL_BANK,
        "git": GIT_BANK,
        "nix": NIX_BANK,
        "herdr": HERDR_BANK,
        "agents": AGENTS_BANK,
    }
    for topic, pairs in sources.items():
        bank[topic] = [{"id": qid(topic, k), "key": k, "desc": d} for k, d in pairs]
    return bank


# ── state ────────────────────────────────────────────────────────────────────

def load(path, default):
    try:
        return json.loads(path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return default


def save(path, data):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=1))


def get_bank():
    bank = load(BANK, None)
    if bank is None:
        print("(first run: building question bank from your configs…)")
        bank = build_bank()
        save(BANK, bank)
    return bank


# ── quiz engine ──────────────────────────────────────────────────────────────

def weight(prog, q):
    s = prog.get("q", {}).get(q["id"], {})
    right, wrong = s.get("r", 0), s.get("w", 0)
    if right + wrong == 0:
        return 3.0            # unseen: high priority
    return 1.0 + 2.5 * wrong / (right + wrong)


def pick_questions(bank, prog, topics, n):
    pool = [(t, q) for t in topics for q in bank.get(t, [])]
    if not pool:
        return []
    weights = [weight(prog, q) for _, q in pool]
    chosen, used = [], set()
    while pool and len(chosen) < n:
        i = random.choices(range(len(pool)), weights=weights, k=1)[0]
        t, q = pool[i]
        if q["id"] not in used:
            used.add(q["id"])
            chosen.append((t, q))
        pool.pop(i)
        weights.pop(i)
    return chosen


def ask(topic, q, distractors):
    """Multiple choice: what does <key> do?"""
    opts = random.sample(distractors, min(3, len(distractors)))
    opts.append(q["desc"])
    random.shuffle(opts)
    correct = opts.index(q["desc"]) + 1
    print(f"\n[{topic}]  What does  \033[1m{q['key']}\033[0m  do?")
    for i, o in enumerate(opts, 1):
        print(f"  {i}) {o}")
    while True:
        a = input("> ").strip()
        if a in ("1", "2", "3", "4")[: len(opts)]:
            break
        if a in ("q", "quit", "exit"):
            return None
        print("answer 1-%d (or q to stop)" % len(opts))
    ok = int(a) == correct
    print("\033[32m  ✓ correct\033[0m" if ok
          else f"\033[31m  ✗ nope\033[0m — {q['key']} → {q['desc']}")
    return ok


def run_quiz(topics, n):
    bank = get_bank()
    prog = load(PROGRESS, {})
    qs = pick_questions(bank, prog, topics, n)
    if not qs:
        print("no questions — run `term-dojo sync` first?")
        return
    all_descs = [q["desc"] for t in topics for q in bank.get(t, [])]
    right = total = 0
    for topic, q in qs:
        others = [d for d in all_descs if d != q["desc"]]
        res = ask(topic, q, others)
        if res is None:
            break
        total += 1
        right += res
        s = prog.setdefault("q", {}).setdefault(q["id"], {"r": 0, "w": 0})
        s["r" if res else "w"] += 1
        s["last"] = int(time.time())
    if total:
        today = date.today().isoformat()
        days = prog.setdefault("days", {})
        d = days.setdefault(today, {"r": 0, "t": 0})
        d["r"] += right
        d["t"] += total
        save(PROGRESS, prog)
        print(f"\nscore: {right}/{total}   (streak: {streak_len(prog)} day(s))")


def streak_len(prog):
    days = sorted(prog.get("days", {}).keys(), reverse=True)
    if not days:
        return 0
    n, cur = 0, date.today()
    for d in days:
        if (cur - date.fromisoformat(d)).days in (0, 1):
            n += 1
            cur = date.fromisoformat(d)
        else:
            break
    return n


# ── drills (hands-on; quiz can't check these — you do them in a real term) ──

