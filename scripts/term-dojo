# ── game content: shell + git missions ──────────────────────────────────────

def _shell_missions():
    def v_forge(d):
        ok = all((d / f"logs/day{i}.md").exists() for i in range(1, 6))
        return ok, "want logs/day1.md through day5.md - mkdir -p logs && touch logs/day{1..5}.md"

    def v_pipe(d):
        want = {"ERROR disk almost full", "ERROR network flap on en0", "ERROR agent pane crashed"}
        got = {ln.strip() for ln in _rd(d, "errors.txt").splitlines() if ln.strip()}
        return got == want, "errors.txt should hold exactly the three ERROR lines - grep ERROR app.log > errors.txt"

    return [
        {"id": "legs.forge", "kind": "shell", "xp": 15,
         "title": "forge files in bulk",
         "bridge": "VSCode: right-click, new file, type a name. five times.\nthe shell does it in one breath: brace expansion.",
         "brief": "in the shell that opens, run:\n  mkdir -p logs && touch logs/day{1..5}.md\nls logs to admire your work, then exit (or ctrl-d).",
         "files": {},
         "verify": v_forge},
        {"id": "legs.pipe", "kind": "shell", "xp": 15,
         "title": "pipes: filter a log",
         "bridge": "VSCode: cmd+F in the file, eyeball the matches, copy them out.\nthe shell composes tools: grep finds, > redirects into a new file.",
         "brief": "app.log is waiting in this directory. build errors.txt holding\nonly the ERROR lines:\n  grep ERROR app.log > errors.txt\ncat errors.txt to check, then exit.",
         "files": {"app.log": """\
INFO boot sequence complete
ERROR disk almost full
INFO user login: myhost
ERROR network flap on en0
INFO cache warmed
ERROR agent pane crashed
INFO all quiet
"""},
         "verify": v_pipe},
    ]


def _git_env(d):
    _sh(d, "git", "init", "-q", "-b", "main")
    _sh(d, "git", "config", "user.email", "dojo@term.local")
    _sh(d, "git", "config", "user.name", "term-dojo")


def _sh(d, *args):
    return subprocess.run(list(args), cwd=str(d), capture_output=True, text=True)


def _git_out(d, *args):
    return _sh(d, "git", *args).stdout.strip()


def _git_missions():
    def setup_stage(d):
        _git_env(d)
        (d / "a.txt").write_text("alpha v1\n")
        (d / "b.txt").write_text("beta v1\n")
        _sh(d, "git", "add", ".")
        _sh(d, "git", "commit", "-q", "-m", "chore: init")
        (d / "a.txt").write_text("alpha v2\n")
        (d / "b.txt").write_text("beta v2\n")

    def v_stage(d):
        if _git_out(d, "rev-list", "--count", "HEAD") != "2":
            return False, "want exactly one new commit on top of the init commit"
        if _git_out(d, "show", "--name-only", "--format=", "HEAD").split() != ["a.txt"]:
            return False, "the new commit must touch only a.txt"
        if "b.txt" not in _git_out(d, "status", "--porcelain"):
            return False, "b.txt should still be dirty - you were too thorough"
        return True, ""

    def setup_branch(d):
        _git_env(d)
        (d / "notes.txt").write_text("teh dojo opens at dawn\n")
        _sh(d, "git", "add", ".")
        _sh(d, "git", "commit", "-q", "-m", "docs: opening notes")

    def v_branch(d):
        if _sh(d, "git", "rev-parse", "--verify", "-q", "fix/typo").returncode != 0:
            return False, "no fix/typo branch yet (gcb fix/typo, or lazygit: n on a branch)"
        tip = _git_out(d, "show", "fix/typo:notes.txt")
        if "teh" in tip or "the dojo" not in tip:
            return False, "fix/typo's notes.txt should say 'the dojo' with the typo gone"
        if "teh" not in _git_out(d, "show", "main:notes.txt"):
            return False, "main should be untouched - branch first, commit there"
        return True, ""

    def setup_stash(d):
        _git_env(d)
        (d / "wip.txt").write_text("steady state\n")
        _sh(d, "git", "add", ".")
        _sh(d, "git", "commit", "-q", "-m", "chore: steady state")
        (d / "wip.txt").write_text("mid-experiment chaos\n")

    def v_stash(d):
        if not _git_out(d, "stash", "list"):
            return False, "nothing stashed - git stash (or lazygit: s in the files panel)"
        dirty = [ln for ln in _git_out(d, "status", "--porcelain").splitlines()
                 if ln and not ln.startswith("??")]
        if dirty:
            return False, "the working tree should be clean after the stash"
        return True, ""

    return [
        {"id": "gitflow.stage", "kind": "git", "xp": 15,
         "title": "surgical staging",
         "bridge": "VSCode: the source control sidebar, + on one file. here lazygit is\nthat sidebar but faster: lg, space stages the file, c commits.",
         "brief": "this repo has a.txt and b.txt both modified. commit ONLY a.txt\n(message up to you). leave b.txt dirty. lazygit (lg) or aliases\n(ga a.txt; gcmsg \"feat: bump alpha\") both count. exit when done.",
         "setup": setup_stage, "verify": v_stage},
        {"id": "gitflow.branch", "kind": "git", "xp": 15,
         "title": "branch, fix, commit",
         "bridge": "VSCode: the branch widget bottom-left. here: gcb fix/typo creates\nand switches in one go (or lazygit: n on the branches panel).",
         "brief": "notes.txt has a typo: teh -> the. create a branch named fix/typo,\nfix the typo there (v notes.txt opens nvim), commit it.\nmain must stay untouched. exit when done.",
         "setup": setup_branch, "verify": v_branch},
        {"id": "gitflow.stash", "kind": "git", "xp": 15,
         "title": "stash the mess",
         "bridge": "VSCode: source control menu, stash, hunt through submenus.\nhere: git stash. two words. gst to confirm the tree is clean.",
         "brief": "wip.txt is mid-experiment and you need a clean tree NOW.\nstash it (git stash, or lazygit: s in the files panel), confirm\nwith gst, leave it stashed, exit.",
         "setup": setup_stash, "verify": v_stash},
    ]


