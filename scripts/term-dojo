def tutor_vim(start=1):
    if not shutil.which("nvim"):
        print("nvim not found on PATH - the vim tutor needs your real Neovim.")
        return
    lessons = vim_tutor_lessons()
    total = len(lessons)
    start = max(1, min(start, total))
    prog = load(PROGRESS, {})
    root = Path(tempfile.mkdtemp(prefix="term-dojo-vim-"))
    print(f"\n\033[1mterm-dojo vim tutor\033[0m - {total} lessons in your real nvim config.")
    print("Each lesson opens nvim on scratch files (instructions are inside the")
    print("file too). Do the task, :wq, and I check the result on exit.")
    done = 0
    i = start
    while i <= total:
        ls = lessons[i - 1]
        d = root / f"lesson{i}"
        if d.exists():
            shutil.rmtree(d)
        for rel, content in ls["files"].items():
            p = d / rel
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(content)
        print(f"\n\033[36m[{i}/{total}] {ls['title']}\033[0m - {ls['brief']}")
        ans = input("  enter opens nvim (s skip, q quit) > ").strip().lower()
        if ans in ("q", "quit"):
            break
        if ans in ("s", "skip"):
            print("  \033[33m→ skipped\033[0m")
            i += 1
            continue
        subprocess.run(["nvim", ls["open"]], cwd=d)
        ok, why = ls["verify"](d)
        if ok:
            print("  \033[32m✓ verified\033[0m")
            tutor_mark_done(prog, "vim", ls["title"])
            done += 1
            i += 1
        else:
            print(f"  \033[31m✗ not quite\033[0m - {why}")
            ans = input("  r retry, s skip, q quit > ").strip().lower()
            if ans in ("q", "quit"):
                break
            if ans in ("s", "skip"):
                i += 1
    shutil.rmtree(root, ignore_errors=True)
    print(f"\nvim tutor: {done} lesson(s) verified this run. `term-dojo stats` remembers.")


def tutor_usage():
    prog = load(PROGRESS, {})
    tut = prog.get("tutor", {})
    print("usage: term-dojo tutor tmux|vim [start-lesson]\n")
    for kind, lessons in (("tmux", tmux_tutor_lessons("", "", "")),
                          ("vim", vim_tutor_lessons())):
        print(f"{kind}:")
        for i, ls in enumerate(lessons, 1):
            mark = "\033[32m✓\033[0m" if ls["title"] in tut.get(kind, {}) else "·"
            print(f"  {mark} {i:>2}  {ls['title']}")
        print()


# ── the game ─────────────────────────────────────────────────────────────────
# `term-dojo game`: a campaign that teaches the whole stack from scratch.
# Premise: total amnesia, except VSCode muscle memory survived. Chapters
# unlock in order; missions are live-verified wherever the tool allows it
# (vim edits on scratch files, tmux against the live server, shell and git
# missions on scratch dirs/repos). Herdr has no scriptable server, so the
# cockpit chapter is scenario quiz + recall (AGENTS.md sharp edge).

MOCHA = {
    "mauve": (203, 166, 247), "blue": (137, 180, 250), "green": (166, 227, 161),
    "red": (243, 139, 168), "yellow": (249, 226, 175), "peach": (250, 179, 135),
    "teal": (148, 226, 213), "lavender": (180, 190, 254), "text": (205, 214, 244),
    "subtext": (166, 173, 200), "overlay": (108, 112, 134),
}


def col(name, s, bold=False):
    r, g, b = MOCHA[name]
    pre = "\033[1m" if bold else ""
    return f"{pre}\033[38;2;{r};{g};{b}m{s}\033[0m"


BELTS = [(0, "white belt"), (40, "yellow belt"), (90, "orange belt"),
         (150, "green belt"), (230, "blue belt"), (320, "purple belt"),
         (410, "brown belt"), (480, "red belt"), (540, "black belt"),
         (589, "sensei")]


def belt(xp):
    cur, nxt = BELTS[0][1], None
    for t, name in BELTS:
        if xp >= t:
            cur = name
        elif nxt is None:
            nxt = (t, name)
    return cur, nxt


GAME_INTRO = """
you wake up on the dojo floor. the year is 2026. you remember... VSCode.
cmd+P. cmd+shift+F. the sidebar. the mouse. nothing else.

this machine has no VSCode. it has Ghostty, zsh, tmux, Neovim, lazygit,
and an agent cockpit called Herdr. the good news: it was configured by
someone who knew you would forget. your cmd keys still work here, and
every VSCode instinct has a sharper native counterpart waiting.

nine chapters stand between you and mastery. missions are verified live:
real edits, real panes, real commits. clear 70% of a chapter to unlock
the next. xp buys belts. the boss trial buys the black belt.
"""


def _after(d, rel, marker):
    """First line following the line that starts with marker (stripped)."""
    lines = _rd(d, rel).splitlines()
    for i, ln in enumerate(lines):
        if ln.strip().startswith(marker) and i + 1 < len(lines):
            return lines[i + 1].strip()
    return ""


def _squash(s):
    return " ".join(s.split())


def _canon_key(s):
    s = s.strip().lower().replace("<", "").replace(">", "")
    for a, b in (("control", "ctrl"), ("command", "cmd"), ("super", "cmd"),
                 ("option", "alt"), ("escape", "esc")):
        s = s.replace(a, b)
    s = re.sub(r"\bc-", "ctrl+", s)
    return re.sub(r"[\s+\-]", "", s)


