         "open": "semi.lua",
         "files": {"semi.lua": """\
-- term-dojo: line ends. 0 = start, $ = end, A = append at end.
-- give each statement below its trailing semicolon (A ; esc), then :wq

local a = 1
local b = 2
local c = 3
"""},
         "verify": lambda d: (all(f"= {n};" in _rd(d, "semi.lua") for n in (1, 2, 3)),
                              "each local line should end with ;")},
        {"id": "first.jumps", "kind": "vim", "xp": 15,
         "title": "gg G: teleport top and bottom",
