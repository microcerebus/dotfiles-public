# ── interactive tutor ────────────────────────────────────────────────────────
# Unlike drills (printed instructions), the tutor verifies you actually did it:
# tmux lessons poll the live tmux server; vim lessons check the buffer edits
# you made in a real nvim session on scratch files.

def tutor_mark_done(prog, kind, title):
    prog.setdefault("tutor", {}).setdefault(kind, {})[title] = int(time.time())
    save(PROGRESS, prog)


def _tmux(*args):
    r = subprocess.run(["tmux", *args], capture_output=True, text=True)
    return r.stdout.rstrip("\n")


def _tfmt(target, fmt):
    return _tmux("display", "-p", "-t", target, fmt)


def wait_for(check, hint=None):
    """Poll check() until true; user may type s⏎ (skip) or q⏎ (quit) meanwhile."""
    t0, hinted = time.time(), False
    while True:
        try:
            if check():
                return "done"
        except (ValueError, OSError):
            pass
        ready, _, _ = select.select([sys.stdin], [], [], 0.4)
        if ready:
            ans = sys.stdin.readline().strip().lower()
            if ans in ("s", "skip"):
                return "skip"
            if ans in ("q", "quit"):
                return "quit"
        if hint and not hinted and time.time() - t0 > 25:
            print(f"  \033[33mhint:\033[0m {hint}")
            hinted = True


def tmux_tutor_lessons(ses, win, pane, ses_name=""):
    """13 lessons against the live server. ses/win/pane identify the tutor's
    own location so lessons can tell 'you left and came back'. ses must be a
    session *id* ($N), not a name: names are fuzzy tmux targets, and lesson 2
    renames a window to 'dojo', which would shadow a session named 'dojo'."""

    def wc():
        return int(_tfmt(ses, "#{session_windows}"))

    def pc():
        return int(_tfmt(win, "#{window_panes}"))

    def here():
        return _tfmt(ses, "#{window_id}") == win and _tfmt(pane, "#{pane_active}") == "1"

    def zoomed():
        return _tfmt(win, "#{window_zoomed_flag}") == "1"

    def nbufs():
        return len([ln for ln in _tmux("list-buffers").splitlines() if ln])

    def geometry():
        return _tmux("list-panes", "-t", win, "-F", "#{pane_id}:#{pane_width}x#{pane_height}")

    def other_panes():
        return [p for p in _tmux("list-panes", "-t", win, "-F", "#{pane_id}").splitlines()
                if p and p != pane]

    lessons = []

    def lesson(title, text, check, setup=None, hint=None):
        lessons.append({"title": title, "text": text, "check": check,
                        "setup": setup, "hint": hint})

    def focus_check(st):
        if not here():
            st["away"] = True
        return st.get("away", False) and here()

    def paste_setup():
        return {"caps": {p: _tmux("capture-pane", "-p", "-t", p) for p in other_panes()}}

    def paste_check(st):
        first = next((ln.strip() for ln in _tmux("show-buffer").splitlines() if ln.strip()), "")
        if len(first) < 2:
            return False
        for p in other_panes():
            cap = _tmux("capture-pane", "-p", "-t", p)
            if first in cap and first not in st["caps"].get(p, ""):
                return True
        return False

    def detach_check(st):
        attached = int(_tfmt(ses, "#{session_attached}") or "1")
        if attached == 0:
            st["gone"] = True
        return st.get("gone", False) and attached > 0

    def reload_setup():
        _tmux("set", "-g", "status-right", " reload me: C-a r ")
        return {}

    lesson("new window, then bounce back",
           "C-a c opens a new window (fresh shell). C-a Tab flips to the last\n"
           "window - this one. Do both.",
           lambda st: wc() > st["w"] and here(),
           setup=lambda: {"w": wc()},
           hint="C-a means: press ctrl+a, release, then press the next key.")
    lesson("rename a window",
           "Hop to the new window (C-a Tab), rename it with C-a , (type: dojo,\n"
           "then enter), and come back with C-a Tab.",
           lambda st: "dojo" in _tmux("list-windows", "-t", ses,
                                      "-F", "#{window_name}").splitlines() and here(),
           hint="C-a , opens a prompt in the status bar; clear it and type dojo.")
    lesson("split right",
           "C-a | opens a pane to the right (it inherits this directory).",
           lambda st: pc() > st["p"],
           setup=lambda: {"p": pc()},
           hint="that is C-a, then shift+backslash (the pipe key).")
    lesson("split down",
           "C-a - splits downward. You should end up with three panes.",
           lambda st: pc() > st["p"],
           setup=lambda: {"p": pc()})
    lesson("move focus, vim style",
           "C-a h/j/k/l moves between panes (same keys as nvim windows).\n"
           "Wander to another pane, then land focus back on THIS one - watch\n"
           "the lavender border follow you.",
           focus_check,
           hint="the pane with the bright border is the focused one.")
    lesson("resize panes",
           "Resize is repeatable: press C-a once, then tap H/J/K/L several\n"
           "times without re-pressing the prefix (H=left J=down K=up L=right).",
           lambda st: pc() > 1 and geometry() != st["g"],
           setup=lambda: {"g": geometry()},
           hint="capital letters - hold shift. Tap L L L to see it move.")
    lesson("zoom a pane",
           "C-a z zooms the focused pane to fill the window.",
           lambda st: zoomed())
    lesson("unzoom",
           "C-a z again restores the layout. Zoom is a toggle.",
           lambda st: not zoomed())
    lesson("copy-mode yank",
           "C-a [ enters copy-mode with vi keys. Move with h/j/k/l or /search,\n"
           "v starts the selection, y yanks it (also lands on the macOS\n"
           "clipboard). Yank any line of text.",
           lambda st: nbufs() > st["b"],
           setup=lambda: {"b": nbufs()},
           hint="stuck in copy-mode? q exits; then C-a [ to try again.")
    lesson("paste into another pane",
           "Focus a different pane (C-a h/j/k/l) and press C-a ] to paste what\n"
           "you yanked at its prompt. No need to run it.",
           paste_check,
           setup=paste_setup,
           hint="nothing pasted? yank a longer line first: C-a [ ... v ... y")
    lesson("kill the extra panes",
           "C-a x kills the focused pane (y to confirm). Close the extra\n"
           "shells until only this pane is left. Do NOT kill this pane - it is\n"
           "running the tutorial.",
           lambda st: pc() == 1,
           hint="typing exit in a shell pane also closes it.")
    lesson("detach, then reattach",
           f"C-a d detaches - tmux and this tutorial keep running. Reattach\n"
           f"from the bare prompt with:  tmux attach -t {ses_name or ses}",
           detach_check,
           hint="after detaching you are back in your plain shell; run the attach command there.")
    lesson("reload the config",
           "I just vandalised your status bar (bottom right). C-a r re-sources\n"
           "tmux.conf and repairs it.",
           lambda st: "reload me" not in _tmux("show-options", "-gv", "status-right"),
           setup=reload_setup,
           hint="C-a r; you should see a 'reloaded' flash and the clock return.")
    return lessons


def tutor_tmux(start=1):
    if not os.environ.get("TMUX"):
        print("the tmux tutor runs inside tmux. From a plain Ghostty tab:")
        print("  tmux new -s dojo")
        print("  term-dojo tutor tmux")
        if os.environ.get("HERDR_ENV") == "1":
            print("(you are in herdr - use a regular Ghostty tab instead.)")
        return
    pane = os.environ.get("TMUX_PANE", "")
    ses = _tfmt(pane, "#{session_id}")
    ses_name = _tfmt(pane, "#{session_name}")
    win = _tfmt(pane, "#{window_id}")
    lessons = tmux_tutor_lessons(ses, win, pane, ses_name)
    total = len(lessons)
    start = max(1, min(start, total))
    prog = load(PROGRESS, {})
    print(f"\n\033[1mterm-dojo tmux tutor\033[0m - {total} lessons, verified against the live server.")
    print("Keys are YOUR tmux.conf bindings (prefix C-a). Do each step for real;")
    print("I detect it. Type s⏎ to skip a lesson, q⏎ to quit. Progress is saved.")
    done = 0
    for i in range(start, total + 1):
        ls = lessons[i - 1]
        print(f"\n\033[36m[{i}/{total}] {ls['title']}\033[0m")
        print("  " + ls["text"].replace("\n", "\n  "))
        st = ls["setup"]() if ls["setup"] else {}
        res = wait_for(lambda: ls["check"](st), ls["hint"])
        if res == "quit":
            break
        if res == "done":
            print("  \033[32m✓ verified\033[0m")
            tutor_mark_done(prog, "tmux", ls["title"])
            done += 1
        else:
            print("  \033[33m→ skipped\033[0m")
    else:
        print("\n\033[1mthat's the whole tmux tour.\033[0m")
    print(f"\ntmux tutor: {done} lesson(s) verified this run. `term-dojo stats` remembers.")


# vim tutor: each lesson writes scratch files, opens your real nvim on them,
# and verifies the edit after you :wq.

def _rd(d, rel):
    try:
        return (d / rel).read_text()
    except FileNotFoundError:
        return ""


def vim_tutor_lessons():
    return [
        {
            "title": "dd - delete a line",
            "brief": "one coffee does not belong; /decaf enter, dd, then :wq",
            "open": "coffee.txt",
            "files": {"coffee.txt": """\
term-dojo lesson: dd (a line has to go)
---------------------------------------
1. one coffee below is marked for removal - move onto its line
   (j/k walks down, or / searches: try the odd one out)
2. dd removes the whole line
3. :wq writes and quits

keep: espresso
keep: pour-over
DELETE ME: decaf
keep: cold brew
"""},
            "verify": lambda d: ("DELETE ME" not in _rd(d, "coffee.txt")
                                 and "cold brew" in _rd(d, "coffee.txt"),
                                 "the DELETE ME line should be gone, the keep lines intact"),
        },
        {
            "title": 'ci" - change inside quotes',
