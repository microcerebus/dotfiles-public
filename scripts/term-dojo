                  ("herdr: show help / all prefix actions", ["ctrl+b ?", "c-b ?", "?"]),
              ]},
             {"id": "cockpit.nix", "kind": "quiz", "xp": 10, "title": "the machine that rebuilds itself",
              "topics": ["nix"], "n": 6, "pass": 4},
         ]},
        {"key": "boss", "name": "The Black Belt Trial", "tag": "everything, no hints",
         "missions": [
             _boss_vim(),
             {"id": "boss.recall", "kind": "quiz", "xp": 30, "title": "total recall",
              "topics": list(TOPICS), "n": 12, "pass": 10},
         ]},
    ]


# ── game engine ──────────────────────────────────────────────────────────────

def ch_done(ch, g):
    return sum(1 for m in ch["missions"] if m["id"] in g["done"])


def ch_need(ch):
    return (len(ch["missions"]) * 7 + 9) // 10  # ceil(70%)


def ch_unlocked(i, chapters, g):
    if i == 0:
        return True
    if chapters[i]["key"] == "boss":
        return all(ch_done(c, g) >= ch_need(c) for c in chapters[:-1])
    prev = chapters[i - 1]
    return ch_done(prev, g) >= ch_need(prev)


def award(prog, g, m):
    before, _ = belt(g["xp"])
    g["done"][m["id"]] = int(time.time())
    g["xp"] += m["xp"]
    save(PROGRESS, prog)
    after, _ = belt(g["xp"])
    print(col("green", f"  verified. +{m['xp']} xp", True)
          + col("subtext", f"  (total {g['xp']} xp)"))
    if after != before:
        print(col("yellow", f"  belt up: you are now a {after}", True))


def play_vim(m, prog):
    if not shutil.which("nvim"):
        print(col("red", "  nvim not found on PATH - skipping"))
        return "skip"
    while True:
        root = Path(tempfile.mkdtemp(prefix="term-dojo-game-vim-"))
        try:
            for rel, content in m["files"].items():
                p = root / rel
                p.parent.mkdir(parents=True, exist_ok=True)
                p.write_text(content)
            if m.get("bridge"):
                print(col("lavender", "  " + m["bridge"].replace("\n", "\n  ")))
            print("  " + m["brief"].replace("\n", "\n  "))
            ans = input(col("subtext", "  enter opens nvim (s skip, q quit) > ")).strip().lower()
            if ans in ("q", "quit"):
                return "quit"
            if ans in ("s", "skip"):
                return "skip"
            subprocess.run(["nvim", m["open"]], cwd=root)
            ok, why = m["verify"](root)
            if ok:
                return "done"
            print(col("red", "  x not quite") + col("subtext", f" - {why}"))
            ans = input(col("subtext", "  r retry (fresh file), s skip, q quit > ")).strip().lower()
            if ans in ("q", "quit"):
                return "quit"
            if ans in ("s", "skip"):
                return "skip"
        finally:
            shutil.rmtree(root, ignore_errors=True)


def play_shellish(m, prog):
    while True:
        d = Path(tempfile.mkdtemp(prefix="term-dojo-game-"))
        try:
            for rel, content in m.get("files", {}).items():
                p = d / rel
                p.parent.mkdir(parents=True, exist_ok=True)
                p.write_text(content)
            if m.get("setup"):
                m["setup"](d)
            if m.get("bridge"):
                print(col("lavender", "  " + m["bridge"].replace("\n", "\n  ")))
            print("  " + m["brief"].replace("\n", "\n  "))
            ans = input(col("subtext", "  enter drops you into a shell there (s skip, q quit) > ")).strip().lower()
            if ans in ("q", "quit"):
                return "quit"
            if ans in ("s", "skip"):
                return "skip"
            subprocess.run([os.environ.get("SHELL", "/bin/zsh")], cwd=d)
            ok, why = m["verify"](d)
            if ok:
                return "done"
            print(col("red", "  x not quite") + col("subtext", f" - {why}"))
            ans = input(col("subtext", "  r retry (fresh setup), s skip, q quit > ")).strip().lower()
            if ans in ("q", "quit"):
                return "quit"
            if ans in ("s", "skip"):
                return "skip"
        finally:
            shutil.rmtree(d, ignore_errors=True)


def play_quiz(m, prog):
    bank = get_bank()
    qs = pick_questions(bank, prog, m["topics"], m["n"])
    if not qs:
        print("  (no questions - run term-dojo sync first)")
        return "skip"
    all_descs = [q["desc"] for t in m["topics"] for q in bank.get(t, [])]
    print(col("subtext", f"  {len(qs)} questions, {m['pass']} correct to pass. q bails."))
    right = 0
    for topic, q in qs:
        res = ask(topic, q, [x for x in all_descs if x != q["desc"]])
        if res is None:
            return "quit"
        right += res
        s = prog.setdefault("q", {}).setdefault(q["id"], {"r": 0, "w": 0})
        s["r" if res else "w"] += 1
        s["last"] = int(time.time())
    save(PROGRESS, prog)
    if right >= m["pass"]:
        print(col("green", f"  passed: {right}/{len(qs)}"))
        return "done"
    print(col("red", f"  {right}/{len(qs)} - need {m['pass']}.")
          + col("subtext", " the map remembers; come back."))
    return "fail"


def play_recall(m, prog):
    items = m["items"]
    print(col("subtext", f"  type the key or command. {m['pass']}/{len(items)} to pass. q bails."))
    right = 0
    for prompt, answers in items:
        a = input(f"  {prompt}\n  > ").strip()
        if a.lower() in ("q", "quit"):
            return "quit"
        if _canon_key(a) in {_canon_key(x) for x in answers}:
            print(col("green", "    yes"))
            right += 1
        else:
            print(col("red", "    no") + col("subtext", f" - it is: {answers[0]}"))
    if right >= m["pass"]:
        print(col("green", f"  passed: {right}/{len(items)}"))
        return "done"
    print(col("red", f"  {right}/{len(items)} - need {m['pass']}.")
          + col("subtext", " drill it and come back."))
    return "fail"


def play_mux_chapter(ch, prog, g):
    if not os.environ.get("TMUX"):
        print("\n  the multiplexer chapter runs inside tmux. from a plain Ghostty tab:")
        print("    tmux new -s dojo")
        print("    term-dojo game mux")
        if os.environ.get("HERDR_ENV") == "1":
            print("  (you are inside herdr - use a regular Ghostty tab; never nest tmux in herdr.)")
        return
    pane = os.environ.get("TMUX_PANE", "")
    ses = _tfmt(pane, "#{session_id}")
    ses_name = _tfmt(pane, "#{session_name}")
    win = _tfmt(pane, "#{window_id}")
    lessons = tmux_tutor_lessons(ses, win, pane, ses_name)
    print(col("subtext", "  live against the tmux server: do each step for real, I detect it."))
    print(col("subtext", "  s + enter skips a mission, q + enter quits."))
    for i, ls in enumerate(lessons):
        m = ch["missions"][i]
        if m["id"] in g["done"]:
            continue
        print("\n" + col("blue", f"  mission: {ls['title']}", True)
              + col("subtext", f"  [{m['xp']} xp]"))
        print("  " + ls["text"].replace("\n", "\n  "))
        st = ls["setup"]() if ls["setup"] else {}
        res = wait_for(lambda: ls["check"](st), ls["hint"])
        if res == "quit":
            return
        if res == "done":
            tutor_mark_done(prog, "tmux", ls["title"])
            award(prog, g, m)
        else:
            print(col("yellow", "  skipped"))


def play_chapter(ch, prog, g):
    print("\n" + col("mauve", f"  chapter: {ch['name']}", True)
          + col("subtext", f"  - {ch['tag']}"))
    if ch["key"] == "mux":
        play_mux_chapter(ch, prog, g)
    else:
        players = {"quiz": play_quiz, "recall": play_recall, "vim": play_vim,
                   "shell": play_shellish, "git": play_shellish}
        for m in ch["missions"]:
            if m["id"] in g["done"]:
                continue
            print("\n" + col("blue", f"  mission: {m['title']}", True)
                  + col("subtext", f"  [{m['xp']} xp]"))
            res = players[m["kind"]](m, prog)
            if res == "quit":
                return
            if res == "done":
                award(prog, g, m)
    if ch_done(ch, g) == len(ch["missions"]):
        print("\n" + col("green", f"  chapter clear: {ch['name']}", True))


def render_map(chapters, prog, g):
    xp = g["xp"]
    cur, nxt = belt(xp)
    print()
    print(col("mauve", "  term-dojo: the amnesiac's path", True))
    status = f"  {cur}   {xp} xp"
    if nxt:
        status += f"   next belt at {nxt[0]}"
    status += f"   streak: {streak_len(prog)} day(s)"
    print(col("text", status))
    if nxt:
        lo = max(t for t, _ in BELTS if t <= xp)
        span = nxt[0] - lo
        fill = int(24 * (xp - lo) / span) if span else 24
    else:
        fill = 24
    print("  " + col("mauve", "█" * fill) + col("overlay", "░" * (24 - fill)))
    for i, ch in enumerate(chapters):
        done, total = ch_done(ch, g), len(ch["missions"])
        tag = col("subtext", f"  - {ch['tag']}")
        if not ch_unlocked(i, chapters, g):
            print(col("overlay", f"   {i + 1}. locked  {ch['name']}") + tag)
        elif done == total:
            print(col("green", f"   {i + 1}. clear   {ch['name']}  {done}/{total}") + tag)
        else:
            print(col("blue", f"   {i + 1}. open    {ch['name']}  {done}/{total}", True) + tag)
    print()


def game_main(args):
    prog = load(PROGRESS, {})
    g = prog.setdefault("game", {})
    g.setdefault("xp", 0)
    g.setdefault("done", {})
    if args and args[0] == "reset":
        a = input("wipe all game progress (xp, belts, missions)? type yes > ").strip().lower()
        if a == "yes":
            prog.pop("game", None)
            save(PROGRESS, prog)
            print("fresh start. run: term-dojo game")
        return
    chapters = game_chapters()
    if not g.get("intro"):
        print(col("lavender", GAME_INTRO))
        g["intro"] = True
        save(PROGRESS, prog)

    def find(tok):
        tok = tok.lower()
        if tok.isdigit() and 1 <= int(tok) <= len(chapters):
            return chapters[int(tok) - 1]
        for c in chapters:
            if c["key"] == tok or c["key"].startswith(tok) or tok in c["name"].lower():
                return c
        return None

    if args:
        ch = find(args[0])
        if not ch:
            print(f"no chapter matching {args[0]!r} - run term-dojo game for the map")
            return
        if not ch_unlocked(chapters.index(ch), chapters, g):
            need = ch_need(chapters[chapters.index(ch) - 1])
            print(f"locked - clear {need} mission(s) in the previous chapter first")
            return
        play_chapter(ch, prog, g)
        render_map(chapters, prog, g)
        return
    while True:
        render_map(chapters, prog, g)
        nxt_ch = None
        for i, c in enumerate(chapters):
            if ch_unlocked(i, chapters, g) and ch_done(c, g) < len(c["missions"]):
                nxt_ch = c
                break
        if nxt_ch is None:
            print(col("mauve", "  every chapter is clear. sensei. teach someone else now.", True))
            return
        try:
            sel = input(col("subtext", f"  enter = {nxt_ch['name']}, 1-{len(chapters)} = pick, q = quit > ")).strip().lower()
        except EOFError:
            return
        if sel in ("q", "quit", "exit"):
            return
        ch = find(sel) if sel else nxt_ch
        if not ch:
            print(f"  no chapter matching {sel!r}")
            continue
        if not ch_unlocked(chapters.index(ch), chapters, g):
            print(col("overlay", "  locked - clear 70% of the previous chapter first"))
            continue
        play_chapter(ch, prog, g)


# ── cheatsheet ───────────────────────────────────────────────────────────────

def gen_cheatsheet():
    bank = get_bank()
    lines = [
        "# Cheatsheet (generated)",
        "",
        "Generated by `term-dojo cheatsheet` from the live configs — do not edit",
        "by hand. Layering contract: Ghostty `cmd+*` · tmux `C-a` · Herdr `C-b`",
        "(details: docs/tmux-training.md).",
    ]
    for topic in TOPICS:
        qs = bank.get(topic, [])
        if not qs:
            continue
        lines += ["", f"## {topic}", "", "| key | action |", "|---|---|"]
        for q in qs:
            key = q["key"].replace("|", "\\|")
            lines.append(f"| `{key}` | {q['desc']} |")
    CHEATSHEET.write_text("\n".join(lines) + "\n")
    print(f"wrote {CHEATSHEET}")


# ── stats ────────────────────────────────────────────────────────────────────

def show_stats():
    bank = get_bank()
    prog = load(PROGRESS, {})
    qstats = prog.get("q", {})
    print(f"streak: {streak_len(prog)} day(s)\n")
    print(f"{'topic':<10} {'seen':>9} {'accuracy':>9}")
    for topic in TOPICS:
        qs = bank.get(topic, [])
        seen = [qstats[q['id']] for q in qs if q["id"] in qstats]
        r = sum(s["r"] for s in seen)
        w = sum(s["w"] for s in seen)
        acc = f"{100 * r // (r + w)}%" if r + w else "—"
        print(f"{topic:<10} {len(seen):>4}/{len(qs):<4} {acc:>9}")
    tut = prog.get("tutor", {})
    if tut:
        totals = {"tmux": len(tmux_tutor_lessons("", "", "")),
                  "vim": len(vim_tutor_lessons())}
        print("\ntutor lessons verified:")
        for kind, total in totals.items():
            n = len(tut.get(kind, {}))
            if n:
                print(f"  {kind:<6} {n}/{total}")
    g = prog.get("game")
    if g:
        cur, _ = belt(g.get("xp", 0))
        total = sum(len(c["missions"]) for c in game_chapters())
        print(f"\ngame: {cur}, {g.get('xp', 0)} xp, "
              f"{len(g.get('done', {}))}/{total} missions cleared")


# ── main ─────────────────────────────────────────────────────────────────────

def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "daily"
    topic_arg = [a for a in args[1:] if a in TOPICS]

    if cmd == "game":
        game_main(args[1:])
    elif cmd == "daily":
        run_quiz(TOPICS, 10)
    elif cmd == "quiz":
        run_quiz(topic_arg or TOPICS, 8)
    elif cmd == "drill":
        for t in (topic_arg or TOPICS):
            print(DRILLS[t], "\n")
    elif cmd == "tutor":
        which = args[1] if len(args) > 1 else ""
        start = int(args[2]) if len(args) > 2 and args[2].isdigit() else 1
        if which == "tmux":
            tutor_tmux(start)
        elif which in ("vim", "nvim", "neovim"):
            tutor_vim(start)
        else:
            tutor_usage()
    elif cmd == "topics":
        bank = get_bank()
        for t in TOPICS:
            print(f"{t:<10} {len(bank.get(t, []))} questions")
    elif cmd == "stats":
        show_stats()
    elif cmd == "sync":
        save(BANK, build_bank())
        print("bank rebuilt from live configs.")
        gen_cheatsheet()
    elif cmd == "cheatsheet":
        gen_cheatsheet()
    else:
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, EOFError):
        print()
